@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background #2FA8D6
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 20px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  color #6D7E8A
  transition color .16s ease
  &:hover
  &.active
    color var(--ios-shell-dark)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, #31C176 0%, #2FA8D6 45%, #F0B35A 75%, #31C176 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color #6D7E8A
  &:hover
    color var(--ios-shell-dark)

.sessions
  position absolute
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 42%, #F7F4F0 100%)
  overflow hidden

.app-theme-defaultDark
  .sessions
    background linear-gradient(135deg, #152631 0%, #1D3340 54%, #253D4A 100%)

.app-theme-defaultGlass
  .sessions
    background linear-gradient(135deg, #DFEAF0 0%, #EEF6F9 100%)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top 48px
  box-shadow none
  &.session-batch-active
    display block

.term-sftp-box
  position relative
  height 100%
  box-sizing border-box
  display flex
  flex-direction column

.session-pane-toolbar
  display flex
  align-items center
  justify-content space-between
  gap 12px
  min-height 36px
  height 36px
  padding 0 14px
  flex-shrink 0
  background rgba(255, 255, 255, .88)
  border-bottom 1px solid rgba(218, 230, 238, .86)
  backdrop-filter var(--glass-sm)
  box-sizing border-box
  .term-sftp-tabs
    display flex
    align-items center
    margin-left 0
    float none
  .term-controls
    display flex
    align-items center
    float none
    margin-left 0

.session-pane-toolbar-right
  display flex
  align-items center
  margin-left auto

.app-theme-defaultDark
  .session-pane-toolbar
    background rgba(38, 58, 70, .92)
    border-bottom-color rgba(169, 204, 224, .14)

.web-session-wrap
  height 100vh
  background var(--ios-bg)
.session-v-info
  line-height 30px
.vnc-scroll-wrapper
  position relative
  background var(--ios-bg)
  z-index 299
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--ios-border)
  &::-webkit-scrollbar-track
    background var(--ios-border)
    box-shadow none
  &::-webkit-scrollbar-thumb
    background rgba(47, 168, 214, .58)
    border-radius 8px
  &::-webkit-scrollbar-corner
    background var(--ios-border)

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

.sess-icon
  margin-right 10px
  &.active
    color var(--warn)

.split-view-toggle
  &.active
    color var(--success)
