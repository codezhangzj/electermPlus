.no-sessions
  background linear-gradient(135deg, #F7FAFC 0%, #EEF4F7 52%, #F7F3EF 100%)
  text-align center
  padding 50px 0
  position absolute
  top 48px
  left 0
  right 0
  bottom 0
  z-index 11
  color #172B36
.no-session-history
  position absolute
  top 320px
  bottom 80px
  left 0
  right 0
  .sidebar-panel-history
    overflow-y auto
    .pd2x
      width 400px
      margin 0 auto
      padding 12px
      border 1px solid var(--ios-border)
      border-radius var(--ios-radius)
      background rgba(255, 255, 255, .72)
      box-shadow var(--ios-shadow-soft)
