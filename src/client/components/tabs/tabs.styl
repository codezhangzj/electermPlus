
.tabs
  position relative
  height 48px
  overflow hidden
  background rgba(255, 255, 255, .34)
  backdrop-filter var(--glass-sm)
  border 0
  border-bottom 1px solid rgba(190, 207, 218, .5)
  border-radius 0
  z-index 12
  margin 0 14px
  box-shadow none
  ::-webkit-scrollbar
    width 0
    display none

.app-theme-defaultDark
  .tabs
    background rgba(20, 34, 43, .28)
    border-color rgba(169, 204, 224, .14)
    box-shadow none
  .tab
    color #D6E3EA
    background transparent
    box-shadow none
    &.active
      color #DDF3FF
      background rgba(82, 142, 181, .16)
      box-shadow inset 0 -2px 0 rgba(124, 212, 255, .78)
  .tabs-add-btn
  .tab-scroll-icon
  .tabs-dd-icon
    color #D6E3EA
    &:hover
      color #FFFFFF
  .tab-close
    color #D6E3EA
    background rgba(255, 255, 255, .12)
  .window-controls
    background rgba(255, 255, 255, .08)
    backdrop-filter var(--glass-sm)
  .window-control-box
    color #D6E3EA
    &:hover
      color #FFFFFF

.app-theme-defaultGlass
  .tabs
    background rgba(255, 255, 255, .26)
    border-color rgba(255, 255, 255, .68)
    box-shadow none
  .tab
    color #748490
    background transparent
    &.active
      color #0A5FB8
      background rgba(255, 255, 255, .48)
      box-shadow inset 0 -2px 0 rgba(10, 132, 255, .72)
.not-system-ui.is-mac .layout-item.v1 .tabs-inner
  margin-left 8px
.not-system-ui.is-mac.not-webapp .layout-item.v1
  .tabs-inner
    margin-left 8px
.not-system-ui.is-mac.not-webapp.pinned .layout-item.v1
  .tabs-inner
    margin-left 8px
.not-system-ui.not-mac.not-webapp
  .tabs-extra
    right 96px
.tabs-inner
  position relative
  z-index 2
  padding 0
  margin-top 0
  display inline-block
  height 48px
  margin-left 8px
  overflow-x scroll
  overflow-y hidden

.tabs-wrapper
  z-index 3
  height 48px
.tab
  display inline-block
  vertical-align middle
  cursor pointer
  position relative
  padding 0 28px 0 22px
  min-width 120px
  max-width 220px
  line-height 32px
  height 32px
  margin 8px 2px 0 0
  border 1px solid transparent
  border-radius 7px 7px 2px 2px
  background transparent
  text-align center
  color var(--ios-muted)
  transition background .16s ease, border-color .16s ease, box-shadow .16s ease, color .16s ease
  &.tab-last
    margin-right 4px
  .tab-close
    opacity 0
    pointer-events none
  &.active
    color #0A5FB8
    border-color rgba(152, 191, 220, .28)
    background rgba(255, 255, 255, .52)
    box-shadow inset 0 -2px 0 rgba(10, 132, 255, .76)
    .tab-close
      opacity 1
      pointer-events auto
  &.active-all
    font-weight bold
  &:hover
    border-color rgba(153, 178, 194, .22)
    background rgba(255, 255, 255, .38)
    .tab-close
      opacity 1
      pointer-events auto
  &.active:hover
    border-color rgba(152, 191, 220, .36)
    background rgba(255, 255, 255, .62)
  &.dragover-tab::after
    position absolute
    content ''
    left -2px
    top 0
    width 1px
    border 1px dashed #2FA8D6
    height 48px
@keyframes blink
  0%
    background-color rgba(47, 168, 214, .18)
  50%
    background-color rgba(255, 255, 255, .78)
  100%
    background-color rgba(47, 168, 214, .18)

.tab-terminal-feed
.tab-traffic
.tab-status
  position absolute
  left 6px
  top 13px
  width 6px
  height 6px
  border-radius 50%
  background-color #9AA8B2
  &.success
    background-color #31C176
  &.error
    background-color #D95757
  &.processing
    background-color #2FA8D6
.tab-traffic
  left 12px
  width 6px
  border-radius 0
  background-color #31C176
  animation blink 2s infinite
.tab-terminal-feed
  width 12px
  height 12px
  border-radius 0
  color #31C176
  font-size 12px
  left 2px
  top 30px
  background none
  background-color transparent !important
  animation blink 2s infinite
  &.password
    color #F0B35A
.tab-close
  position absolute
  right 7px
  cursor pointer
  top 50%
  background transparent
  margin-top -8px
  border-radius 100%
  color #5D707C
  height 16px
  width 16px
  text-align center
  line-height 16px
  font-size 9px
  transition opacity .16s ease, background .16s ease, color .16s ease
  &:hover
    background #D95757
    color #FFFFFF

.tabs-add-btn
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle
  width 30px
  height 30px
  margin 9px 4px 0 2px
  border-radius 7px
  color var(--ios-muted)
  transition background .16s ease, color .16s ease
  &.empty
    font-size 18px
    margin-left 0
    margin-top 9px
  &:hover
    color var(--ios-shell-dark)
    background rgba(255, 255, 255, .48)
.tabs-extra
  position absolute
  height 48px
  top 0
  right 0
  line-height 48px
  z-index 20
  display flex
  align-items center

  .tabs-dd-icon
    font-size 12px
  .tabs-add-btn
    margin-top 0

.layout-dd-icon
  display inline-flex
  align-items center
  justify-content center
  gap 5px
  width 38px
  height 30px
  border-radius 7px
  color var(--ios-muted)
  cursor pointer
  transition background .16s ease, color .16s ease
  &:hover
    color var(--ios-shell-dark)
    background rgba(255, 255, 255, .48)

.app-theme-defaultDark
  .tab:hover
    color #DDF3FF
    border-color rgba(124, 212, 255, .12)
    background rgba(255, 255, 255, .08)
  .tab.active:hover
    border-color rgba(124, 212, 255, .18)
    background rgba(82, 142, 181, .2)
  .tabs-add-btn:hover
  .layout-dd-icon:hover
    color #FFFFFF
    background rgba(255, 255, 255, .08)

.window-controls
  position absolute
  right 0
  top 0
  z-index 900
  height 48px
  border-radius 0
  padding 0
  background transparent
  backdrop-filter none
  -webkit-app-region no-drag

.window-control-box
  display inline-flex
  align-items center
  justify-content center
  width 32px
  height 48px
  padding 0
  color var(--ios-muted)
  &:hover
    color var(--ios-shell-dark)
    cursor pointer
    .icon-maximize
      border-color var(--primary)
.icon-maximize
  width 10px
  height 7px
  border 1px solid #5D707C
  cursor pointer
  &.is-max
    height 6px
    position relative
    &:before
      position absolute
      content ''
      left -3px
      top 3px
      width 8px
      height 4px
      border 1px solid text
      border-top none
      border-right none

.control-icon:hover
  color var(--ios-shell-dark)
.tab-scroll-icon
  color var(--ios-muted)
  &:hover
    color var(--ios-shell-dark)

.window-controls
  .window-control-minimize
  .window-control-maximize
    &:hover
      background rgba(236, 246, 253, .78)
  .window-control-close:hover
    background #D95757
    color #FFFFFF

.system-ui
  .window-controls
    display none
.tab-title-tag
  margin-right 5px
  font-size 14px

.ssh-tunnel-list-wrapper
  max-height 300px
  overflow-y auto

// Layout and Workspace dropdown styles
.layout-workspace-dropdown
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  min-width 200px
  padding 8px
  .ant-tabs-nav
    margin-bottom 8px

.layout-menu-content
  max-height 300px
  overflow-y auto

.layout-menu-item
  padding 6px 12px
  cursor pointer
  border-radius 8px
  display flex
  align-items center
  gap 8px
  color var(--ios-text)
  &:hover
    background rgba(236, 246, 253, .78)
  &.active
    background linear-gradient(180deg, rgba(237, 247, 255, .96), rgba(221, 240, 255, .86))
    color #0A5FB8
    box-shadow inset 0 0 0 1px rgba(136, 194, 255, .45)

.workspace-menu-content
  max-height 300px
  overflow-y auto

.workspace-save-btn
  margin-bottom 8px

.workspace-list
  display flex
  flex-direction column
  gap 4px

.workspace-item
  padding 6px 12px
  cursor pointer
  border-radius 8px
  display flex
  align-items center
  justify-content space-between
  color var(--ios-text)
  &:hover
    background rgba(236, 246, 253, .78)
  .workspace-delete-icon
    opacity 0
    color #6D7E8A
    &:hover
      color #D95757
  &:hover .workspace-delete-icon
    opacity 1

.workspace-name
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.not-webapp.not-win
  .tab
  .tabs-add-btn
  .window-control-box
  .tab-close
  .tab-reload
  .tabs-extra
    -webkit-app-region no-drag
