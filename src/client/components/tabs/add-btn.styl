
.add-menu-wrap
  position fixed
  z-index 1000
  background linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(247, 251, 253, .82))
  backdrop-filter var(--glass)
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 14px 28px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .9)
  min-width 300px
  max-width 600px
  overflow hidden
  margin-top 6px
  padding 8px 15px
  display flex
  flex-direction column
  .drag-handle
    right 3px
    display block
  .add-menu-header
    flex-shrink 0
    color var(--ios-shell-dark)
    font-weight 800
  .add-menu-list
    flex 1
    overflow hidden
    display flex
    flex-direction column
    min-height 0
    .sidebar-panel-history
      position relative
      top auto
      left auto
      right auto
      bottom auto
      flex 1
      min-height 0
