.sftp-wrap
  display flex
  flex-direction row
  background linear-gradient(135deg, #F7FAFC 0%, #EEF4F7 100%)
.sftp-section
  flex 1
  padding 8px
.sftp-title-wrap
  position relative
.sftp-item
  position relative
  z-index 3
  padding 0
  line-height 26px
  height 32px
  user-select none
  margin-bottom 4px
  border-radius var(--ios-radius)
  overflow hidden
  &:nth-child(even)
    .sftp-file-prop
      background rgba(255, 255, 255, .72)
  &:hover
    .sftp-file-prop
      background-color rgba(47, 168, 214, .08)
      color #172B36
  &.selected
    .sftp-file-prop
      background-color #13242F
      color #fff
.sftp-history
  position absolute
  left 0
  top 100%
  right 0
  z-index 30
  box-shadow none
  border none
  height 0
  background var(--ios-surface-strong)
  overflow hidden
  border-radius var(--ios-radius)
  backdrop-filter blur(18px)
  &.focused
    height auto
    border 1px solid var(--ios-border)
    box-shadow var(--ios-shadow)

.sftp-history-item
  padding 5px 10px
  cursor pointer
  border-bottom 1px solid var(--ios-border)
  border-radius var(--ios-radius-sm)
  &:hover
    background rgba(47, 168, 214, .08)
    color #172B36

.sftp-item-title
  width 100%
.sftp-item-title
    width 75%
.sftp-item-size
  width 24%
.sftp-status-success
  color var(--success)
.sftp-status-exception
  color var(--error)
.sftp-status-active
  color var(--primary)

.virtual-file
  .sftp-item
    position absolute
    left 0
    right 10px
    bottom 0
    top 0
    z-index 1
    height 100%
    padding 0
    margin 0

.file-icon
  position absolute
  left 10px
  top 10px
  font-size 50px
.file-props-div
  display flex
  width 100%
.file-props
  margin-left 70px

.sftp-sort-btn
  &.active
    font-weight bold
    color #13242F

//list table
.sftp-file-prop
  flex 0 0 auto
  height 32px
  line-height 30px
  padding 0 5px
  background rgba(255, 255, 255, .82)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  pointer-events none
  cursor default
  color var(--text)

.file-bg
  position absolute
  left 0
  top 0
  right 0
  height 32px
  z-index 3

.sftp-header-item
  height 28px
  line-height 25px
  padding 0 5px
  background rgba(247, 250, 252, .92)
  color var(--text-dark)
  font-weight 700
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.sftp-file-table-header
  height 30px
.sftp-table
  z-index 2
  &:hover
    ::-webkit-scrollbar
      width 12px
.sftp-item
  &.sftp-dragover
    .sftp-file-prop
      background var(--primary) !important
      color #FFFFFF !important
  &.sftp-dragover-multi
    &:after
    &:before
      position absolute
      left 2px
      top 2px
      width 100%
      height 100%
      background rgba(47, 168, 214, .18)
      content ''
      z-index -1
    &:after
      left 4px
      top 4px
.icon-holder
  width 1em
  display inline-block
.symbolic-link-icon
  margin-right 2px

//sftp
.sftp-panel
  background var(--ios-surface)
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  box-shadow var(--ios-shadow-soft)
  backdrop-filter blur(18px)

.file-list
  ::-webkit-scrollbar-thumb
    background-color rgba(47, 168, 214, .58) !important

.pager-wrap
  z-index 4
  position relative

.sftp-has-pager
  .sftp-table-content
    padding-bottom 42px
  .pager-wrap
    position absolute
    bottom 0
    left 0
    width 100%
    background var(--ios-surface-strong)
    height 40px
    border-top 1px solid var(--ios-border)

.file-header-context-menu
  position fixed
  z-index 999

.keyword-filter-icon
  &:hover
  &.active
    color var(--success)
