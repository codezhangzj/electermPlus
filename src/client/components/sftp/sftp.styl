.sftp-wrap
  display flex
  flex-direction row
  background linear-gradient(135deg, var(--ios-bg) 0%, var(--ios-bg-soft) 100%)
.sftp-section
  flex 1
  padding 8px
.sftp-title-wrap
  position relative
.sftp-item
  position relative
  z-index 3
  padding 0
  line-height 26px
  height 32px
  user-select none
  margin-bottom 4px
  border-radius 8px
  overflow hidden
  border 1px solid transparent
  transition border-color .16s ease, box-shadow .16s ease
  &:nth-child(even)
    .sftp-file-prop
      background rgba(255, 255, 255, .74)
  &:hover
    border-color rgba(218, 230, 238, .86)
    .sftp-file-prop
      background-color rgba(236, 246, 253, .82)
      color var(--ios-shell-dark)
  &.selected
    border-color rgba(136, 194, 255, .46)
    box-shadow 0 6px 14px rgba(10, 132, 255, .1)
    .sftp-file-prop
      background-color rgba(221, 240, 255, .9)
      color #0A5FB8
.sftp-history
  position absolute
  left 0
  top 100%
  right 0
  z-index 30
  box-shadow none
  border none
  height 0
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .84))
  overflow hidden
  border-radius 8px
  backdrop-filter blur(20px) saturate(1.06)
  &.focused
    height auto
    border 1px solid rgba(218, 230, 238, .86)
    box-shadow 0 14px 28px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .9)

.sftp-history-item
  padding 5px 10px
  cursor pointer
  border-bottom 1px solid rgba(218, 230, 238, .72)
  border-radius 8px
  &:hover
    background rgba(236, 246, 253, .78)
    color var(--ios-shell-dark)

.sftp-item-title
  width 100%
.sftp-item-title
    width 75%
.sftp-item-size
  width 24%
.sftp-status-success
  color var(--success)
.sftp-status-exception
  color var(--error)
.sftp-status-active
  color var(--primary)

.virtual-file
  .sftp-item
    position absolute
    left 0
    right 10px
    bottom 0
    top 0
    z-index 1
    height 100%
    padding 0
    margin 0

.file-icon
  position absolute
  left 10px
  top 10px
  font-size 50px
.file-props-div
  display flex
  width 100%
.file-props
  margin-left 70px

.sftp-sort-btn
  &.active
    font-weight bold
    color var(--ios-shell-dark)

//list table
.sftp-file-prop
  flex 0 0 auto
  height 32px
  line-height 30px
  padding 0 5px
  background rgba(255, 255, 255, .82)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  pointer-events none
  cursor default
  color var(--ios-text)

.file-bg
  position absolute
  left 0
  top 0
  right 0
  height 32px
  z-index 3

.sftp-header-item
  height 28px
  line-height 25px
  padding 0 5px
  background rgba(247, 250, 252, .9)
  color var(--ios-muted)
  font-weight 700
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.sftp-file-table-header
  height 30px
.sftp-table
  z-index 2
  &:hover
    ::-webkit-scrollbar
      width 12px
.sftp-item
  &.sftp-dragover
    .sftp-file-prop
      background var(--primary) !important
      color #FFFFFF !important
  &.sftp-dragover-multi
    &:after
    &:before
      position absolute
      left 2px
      top 2px
      width 100%
      height 100%
      background rgba(47, 168, 214, .18)
      content ''
      z-index -1
    &:after
      left 4px
      top 4px
.icon-holder
  width 1em
  display inline-block
.symbolic-link-icon
  margin-right 2px

//sftp
.sftp-panel
  background linear-gradient(160deg, rgba(255, 255, 255, .88), rgba(247, 251, 253, .76))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 12px 24px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter blur(20px) saturate(1.06)

.file-list
  ::-webkit-scrollbar-thumb
    background-color rgba(47, 168, 214, .58) !important

.pager-wrap
  z-index 4
  position relative

.sftp-has-pager
  .sftp-table-content
    padding-bottom 42px
  .pager-wrap
    position absolute
    bottom 0
    left 0
    width 100%
    background rgba(255, 255, 255, .9)
    height 40px
    border-top 1px solid rgba(218, 230, 238, .86)

.file-header-context-menu
  position fixed
  z-index 999

.keyword-filter-icon
  &:hover
  &.active
    color var(--success)

.app-theme-defaultDark
  .sftp-wrap
    background linear-gradient(135deg, rgba(21, 38, 49, .96), rgba(37, 61, 74, .9))
  .sftp-panel
    background linear-gradient(160deg, rgba(43, 63, 76, .86), rgba(25, 41, 51, .76))
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .07)
  .sftp-file-prop
    color #DDEBF0
    background rgba(255, 255, 255, .06)
  .sftp-item
    &:nth-child(even)
      .sftp-file-prop
        background rgba(255, 255, 255, .08)
    &:hover
      border-color rgba(169, 204, 224, .18)
      .sftp-file-prop
        background rgba(255, 255, 255, .11)
        color #FFFFFF
    &.selected
      border-color rgba(124, 212, 255, .24)
      box-shadow 0 6px 14px rgba(0, 0, 0, .14)
      .sftp-file-prop
        color #DDF3FF
        background linear-gradient(180deg, rgba(82, 142, 181, .34), rgba(47, 91, 118, .26))
  .sftp-header-item
    color #95AAB4
    background rgba(255, 255, 255, .07)
  .sftp-history
    color #DDEBF0
    background linear-gradient(180deg, rgba(43, 63, 76, .92), rgba(25, 41, 51, .84))
    &.focused
      border-color rgba(169, 204, 224, .16)
      box-shadow 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .07)
  .sftp-history-item
    border-bottom-color rgba(169, 204, 224, .12)
    &:hover
      color #FFFFFF
      background rgba(255, 255, 255, .1)
  .pager-wrap
    background rgba(35, 53, 64, .88)
    border-top-color rgba(169, 204, 224, .14)
  .sftp-sort-btn
    &.active
      color #DDF3FF

.app-theme-defaultGlass
  .sftp-wrap
    background linear-gradient(135deg, #DFEAF0 0%, #EEF6F9 100%)
  .sftp-panel
    background linear-gradient(160deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    border-color rgba(255, 255, 255, .74)
    box-shadow 0 10px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .7)
  .sftp-file-prop
    background rgba(255, 255, 255, .64)
  .sftp-item:nth-child(even)
    .sftp-file-prop
      background rgba(255, 255, 255, .56)
  .sftp-header-item
    background rgba(255, 255, 255, .54)
  .sftp-history
    background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    &.focused
      border-color rgba(255, 255, 255, .74)
      box-shadow 0 10px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .7)
  .sftp-has-pager
    .pager-wrap
      background rgba(255, 255, 255, .68)
      border-top-color rgba(255, 255, 255, .74)
