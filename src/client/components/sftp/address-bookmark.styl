.sftp-history-item.addr-bookmark-item
  padding 8px 32px 8px 10px
  position relative
  border 1px solid transparent
  border-radius 8px
  background rgba(255, 255, 255, .54)
  transition background .16s ease, border-color .16s ease, box-shadow .16s ease
  &:hover
    border-color rgba(218, 230, 238, .86)
    background rgba(255, 255, 255, .86)
    box-shadow 0 6px 14px rgba(49, 66, 77, .07)
.del-addr-bookmark
  position absolute
  right 8px
  top 50%
  transform translateY(-50%)
  cursor pointer
  color var(--ios-muted)
  &:hover
    color #D95757
