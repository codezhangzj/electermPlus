
.terminal-info-icon
  color var(--text-dark)
  &:hover
    color var(--text)
.info-panel-wrap
  position fixed
  right 0
  top 100px
  bottom 0
  width 500px
  background #F7FAFC
  backdrop-filter blur(18px)
  border 1px solid #E6EEF3
  border-radius 10px 0 0 10px
  border-right none
  color var(--text)
  z-index 100
  overflow-y scroll

  .drag-handle
    left 0
    right auto
    display block
.terminal-info-section
  padding 12px
  margin-bottom 12px
  border 1px solid #E6EEF3
  border-radius 10px
  background rgba(255, 255, 255, .82)
  box-shadow 0 8px 18px rgba(64, 81, 93, .08)
.terminal-info-act
.terminal-info-disk
.terminal-info-network
  max-height 260px
  overflow-y scroll
.activity-item
  max-height 1.6em
  line-height 1.6
  overflow hidden
  &:hover
    max-height none
.info-panel-wrap-pin
  .toggle-info-panel-wrap
    color var(--success)
