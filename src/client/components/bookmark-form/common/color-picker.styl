.color-picker-unit
  display inline-block
  padding 6px
  margin-right 6px
  margin-bottom 6px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  cursor pointer
  background rgba(255, 255, 255, .82)
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  width 92px
  transition border-color .16s ease, box-shadow .16s ease, transform .16s ease
  &:hover
    border-color rgba(136, 194, 255, .55)
    box-shadow 0 10px 20px rgba(49, 66, 77, .09), inset 0 1px 0 rgba(255, 255, 255, .94)
    transform translateY(-1px)
.color-picker-box
  width 420px

.color-picker-defaults
  width 200px
.color-picker-choose
  width 18px
  height 18px
  cursor pointer
  border-radius 6px
  box-shadow inset 0 0 0 1px rgba(19, 36, 47, .14)
