.color-picker-unit
  display inline-block
  padding 6px
  margin-right 6px
  margin-bottom 6px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  cursor pointer
  background rgba(255, 255, 255, .82)
  box-shadow 0 6px 12px rgba(49, 66, 77, .08)
  width 92px
  transition border-color .16s ease, box-shadow .16s ease, transform .16s ease
  &:hover
    border-color rgba(47, 168, 214, .42)
    box-shadow 0 8px 16px rgba(49, 66, 77, .10)
    transform translateY(-1px)
.color-picker-box
  width 420px

.color-picker-defaults
  width 200px
.color-picker-choose
  width 18px
  height 18px
  cursor pointer
  border-radius 6px
  box-shadow inset 0 0 0 1px rgba(19, 36, 47, .14)
