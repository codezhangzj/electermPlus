.mg24b
  margin-bottom 24px
.mg60b
  margin-bottom 60px
.bookmark-form
  .ant-tabs-nav
    margin-bottom 16px
    padding 6px
    border 1px solid rgba(218, 230, 238, .86)
    border-radius 8px
    background rgba(255, 255, 255, .72)
    box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  .ant-tabs-tab
    padding 7px 12px
    border-radius 8px
    font-weight 700
  .ant-tabs-tab-active
    background linear-gradient(180deg, rgba(237, 247, 255, .96), rgba(221, 240, 255, .86))
    box-shadow inset 0 0 0 1px rgba(136, 194, 255, .45), 0 6px 14px rgba(10, 132, 255, .11)
    .ant-tabs-tab-btn
      color #0A5FB8 !important
  .ant-form-item
    margin-bottom 14px
  .ant-form-item-label > label
    color var(--ios-text)
    font-weight 700
  .ant-collapse
    border 1px solid rgba(218, 230, 238, .86)
    border-radius 8px
    background rgba(255, 255, 255, .72)
    box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  .ant-collapse-item
    border-color rgba(218, 230, 238, .86)
  .ant-collapse-header
    font-weight 800
    color var(--ios-shell-dark) !important
  .ant-collapse-content
    background rgba(255, 255, 255, .64)
    border-color rgba(218, 230, 238, .86)
.compact-input input
  width 80px !important
.ssh-tunnels-host
  margin-bottom 0
.ip-item
  line-height 34px
  padding 0 8px
  border-radius 8px
  color var(--ios-text)
  .item-item-use
    display none
.ip-item:hover
    background rgba(236, 246, 253, .78)
    .item-item-use
      display inline-block
.number-input
  min-width 210px

.tree-select-wrapper
  display flex
  flex-direction column
  height 100%
  overflow hidden
  padding 12px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .82)
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)

.tree-select-header
  flex-shrink 0

.tree-select-content
  flex 1
  overflow auto
  margin-top 8px

.bookmark-json-preview
  padding 14px
  max-height 300px
  overflow auto
  font-size 12px
  font-family "SF Mono", Menlo, Consolas, monospace
  border 1px solid rgba(255, 255, 255, .12)
  border-radius 8px
  background var(--ios-terminal-dark)
  color #DDEBF0

.app-theme-defaultDark
  .bookmark-form
    .ant-tabs-nav
    .ant-collapse
      background rgba(255, 255, 255, .06)
      border-color rgba(169, 204, 224, .16)
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .06)
    .ant-tabs-tab-active
      background linear-gradient(180deg, rgba(82, 142, 181, .34), rgba(47, 91, 118, .26))
      box-shadow inset 0 0 0 1px rgba(124, 212, 255, .22), 0 6px 14px rgba(0, 0, 0, .14)
      .ant-tabs-tab-btn
        color #DDF3FF !important
    .ant-form-item-label > label
    .ant-collapse-header
      color #DDEBF0 !important
    .ant-collapse-item
    .ant-collapse-content
      border-color rgba(169, 204, 224, .16)
    .ant-collapse-content
      background rgba(255, 255, 255, .04)
  .tree-select-wrapper
    background rgba(255, 255, 255, .06)
    border-color rgba(169, 204, 224, .16)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .06)

.app-theme-defaultGlass
  .bookmark-form
    .ant-tabs-nav
    .ant-collapse
      background rgba(255, 255, 255, .58)
      border-color rgba(255, 255, 255, .72)
  .tree-select-wrapper
    background rgba(255, 255, 255, .64)
    border-color rgba(255, 255, 255, .72)
