.transports-wrap
  position absolute
  left 60px
  top 3px
  right 60px
  height 36px

.transports-circle-wrap
  text-align center
  position relative
  z-index 10
.transports-dd
  position absolute
  left 0
  right 0
  overflow-y scroll
  z-index 11
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .84))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 14px 28px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .9)
  backdrop-filter blur(20px) saturate(1.06)

.transports-wrap
  .transports-dd
    display none
  &:hover .transports-dd
    display block

.transports-title
  border-bottom 1px solid rgba(218, 230, 238, .86)
  padding 10px 15px
.transports-content
  max-height 200px
  padding 10px 0
.sftp-transport
  display flex
  padding 8px 5px
  border-radius 8px
  &:hover
    font-weight bold
    background rgba(236, 246, 253, .78)
  .transfer-control-icon
    padding-right 5px
    padding-left 5px
    margin-top -2px
    &:hover
      color #fff
      background #0A84FF
      border-radius 8px

.flex-child + .flex-child
  margin-left 5px
  flex-grow 1
.transfer-control-icon
  margin-right 3px
  margin-top 3px

.app-theme-defaultDark
  .transports-dd
    color #DDEBF0
    background linear-gradient(180deg, rgba(43, 63, 76, .92), rgba(25, 41, 51, .84))
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .07)
  .transports-title
    border-bottom-color rgba(169, 204, 224, .14)
  .sftp-transport
    color #D6E3EA
    &:hover
      color #FFFFFF
      background rgba(255, 255, 255, .1)
    .transfer-control-icon
      &:hover
        color #06131A
        background #7CD4FF

.app-theme-defaultGlass
  .transports-dd
    background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    border-color rgba(255, 255, 255, .74)
    box-shadow 0 10px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .7)
  .transports-title
    border-bottom-color rgba(255, 255, 255, .74)
