.transports-wrap
  position absolute
  left 60px
  top 3px
  right 60px
  height 36px

.transports-circle-wrap
  text-align center
  position relative
  z-index 10
.transports-dd
  position absolute
  left 0
  right 0
  overflow-y scroll
  z-index 11
  background var(--ios-surface-strong)
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  box-shadow var(--ios-shadow)
  backdrop-filter blur(18px)

.transports-wrap
  .transports-dd
    display none
  &:hover .transports-dd
    display block

.transports-title
  border-bottom 1px solid var(--ios-border)
  padding 10px 15px
.transports-content
  max-height 200px
  padding 10px 0
.sftp-transport
  display flex
  padding 8px 5px
  border-radius var(--ios-radius)
  &:hover
    font-weight bold
    background #F1F6FA
  .transfer-control-icon
    padding-right 5px
    padding-left 5px
    margin-top -2px
    &:hover
      color #fff
      background #13242F
      border-radius var(--ios-radius-sm)

.flex-child + .flex-child
  margin-left 5px
  flex-grow 1
.transfer-control-icon
  margin-right 3px
  margin-top 3px
