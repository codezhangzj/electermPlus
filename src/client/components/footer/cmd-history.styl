.cmd-history-popover-content
  max-height 300px
  width 300px
  overflow hidden
  display flex
  flex-direction column
  color #172B36

.cmd-history-search
  flex-shrink 0
  position sticky
  top 0
  padding-bottom 8px
  background rgba(255, 255, 255, .86)

.cmd-history-header
  flex-shrink 0
  display flex
  align-items center
  justify-content space-between
  padding 2px 2px 10px
  font-weight 800
  color #13242F

.cmd-history-clear-icon
  font-size 14px
  padding 5px
  cursor pointer
  border-radius 7px
  color #7A8B96
  &:hover
    color #D95757
    background rgba(217, 87, 87, .10)

.cmd-history-list
  overflow-x hidden
  overflow-y auto
  flex 1
  min-height 0

.cmd-history-item
  display flex
  align-items center
  justify-content space-between
  padding 7px 8px
  cursor pointer
  border-radius var(--ios-radius-sm)
  transition background .16s ease
  &:hover
    background rgba(47, 168, 214, .08)

.cmd-history-item-text
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  flex 1
  min-width 0

.cmd-history-item-count
  font-size 12px
  color #84939D
  padding 0 4px
  flex-shrink 0

.cmd-history-item-actions
  display none
  flex-shrink 0
  gap 4px
  align-items center
  .cmd-history-item:hover &
    display flex

.cmd-history-item-delete
  cursor pointer
  padding 3px 5px
  border-radius 6px
  &:hover
    color #D95757
    background rgba(217, 87, 87, .10)

.cmd-history-item-copy
  cursor pointer
  padding 3px 5px
  border-radius 6px
  &:hover
    color #2FA8D6
    background rgba(47, 168, 214, .10)
