.control-icon-wrap
  .ant-badge-count-sm
    font-size 11px
  .ant-badge-multiple-words
    padding 0 3px
.transfer-list-card
  width 920px
  max-width calc(100vw - 112px)
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .88)
  box-shadow 0 14px 28px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .9)
  .ant-popover-inner
    overflow hidden
.sftp-file
  max-width calc(50vw - 250px)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  &.history-file
    max-width calc(50vw - 440px)

.app-theme-defaultDark
  .transfer-list-card
    color #DDEBF0
    background linear-gradient(180deg, rgba(43, 63, 76, .9), rgba(25, 41, 51, .82))
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .07)

.app-theme-defaultGlass
  .transfer-list-card
    background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    border-color rgba(255, 255, 255, .74)
    box-shadow 0 10px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .7)
