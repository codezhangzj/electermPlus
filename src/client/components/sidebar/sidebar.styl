
.animate-fast
  animation-duration .2s
.sidebar-panel
  position absolute
  left 0
  top 0
  bottom 0
  z-index 200
  width 0
  overflow-y scroll
  background linear-gradient(180deg, rgba(252, 254, 255, .9), rgba(243, 248, 252, .82))
  backdrop-filter var(--glass-lg)
  border-right 1px solid rgba(214, 226, 235, .74)
  box-shadow 12px 0 28px rgba(68, 86, 99, .1), inset 1px 0 0 rgba(255, 255, 255, .78)
  .item-list-unit:hover
    .list-item-remove
      display none !important
.sidebar-panel
  top 48px
.sidebar
  position absolute
  left 0
  top 0
  width 72px
  z-index 100
  bottom 0
  background linear-gradient(180deg, rgba(255, 255, 255, .9) 0%, rgba(245, 250, 252, .84) 52%, rgba(239, 246, 250, .82) 100%)
  box-shadow 6px 0 24px rgba(68, 86, 99, .12), inset -1px 0 0 rgba(214, 226, 235, .78)
  backdrop-filter var(--glass-lg)
  -webkit-app-region drag
  &::before
    content ''
    position absolute
    left 10px
    right 10px
    top 12px
    height 1px
    background rgba(255, 255, 255, .86)
    pointer-events none

  .item-list
    padding-right 0
.sidebar-pin-top
  position absolute
  left 0
  right 0
  top 0
  height 112px
.sidebar-panel-bookmarks
.sidebar-panel-history
  position absolute
  left 0
  right 0
  top 112px
  bottom 0
  overflow hidden
  display flex
  flex-direction column
  .sidebar-inner
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
  .history-header
    flex-shrink 0
    display flex
    align-items center
    border-bottom 1px solid var(--ios-border)
    position sticky
    top 0
    z-index 10
    background rgba(255, 255, 255, .86)
    backdrop-filter var(--glass-sm)
    .history-clear-icon
      margin-left auto
      margin-right 0
      color #6D7E8A
      &:hover
        color #D95757
  .history-body
    flex 1
    overflow-y auto
    overflow-x hidden
.not-system-ui.is-mac
  .sidebar-bar
    margin-top 36px
    .control-icon-wrap:first-child
      padding-top 16px
.type-bookmarks
  .bookmarks-panel
    width 100%
.type-history
  .history-panel
    width 100%
.control-icon-text
  color var(--ios-muted)
  &:hover
    color #0A84FF
.control-icon-wrap
  width 40px
  height 40px
  margin 7px auto
  padding 0
  border-radius 8px
  text-align center
  display flex
  align-items center
  justify-content center
  -webkit-app-region no-drag
  transition all .3s cubic-bezier(0.25, 0.8, 0.25, 1)
  &.active
    background linear-gradient(180deg, rgba(237, 247, 255, .96), rgba(221, 240, 255, .86))
    box-shadow inset 0 0 0 1px rgba(136, 194, 255, .45), 0 6px 14px rgba(10, 132, 255, .13)
    .control-icon
      color #0A84FF
  &:hover
    background rgba(236, 246, 253, .78)
    transform translateY(-1px)
  .control-icon
    color var(--ios-muted)
    cursor pointer
    transition color .3s ease, transform .3s cubic-bezier(0.25, 0.8, 0.25, 1)
    &:hover
      color #0A84FF
      transform scale(1.1)
.sidebar-list
  position absolute
  left 72px
  top 0
  bottom 0
  z-index 200
  width 0

.pinned
  .sidebar-list
    top 0
    .sidebar-panel
      top 0
      padding-top 48px
  .drag-handle
    display block
  .sidebar-panel
    .pinned
      color var(--success)
//btns
.btns
  background transparent
  border-color rgba(214, 226, 235, .64)
  .open-about-icon
    color var(--ios-muted)
    &:hover
      color #0A84FF

.btns .upgrade-icon
  color #25B36B
.close-info-modal
  cursor pointer
  &:hover
    color var(--ios-shell-dark)
.logo-filter
  filter none
.sidebar-inner
  padding-right 8px

.app-theme-defaultDark
  .sidebar
    background linear-gradient(180deg, rgba(48, 68, 80, .9), rgba(28, 45, 56, .86))
    border-right 1px solid rgba(169, 204, 224, .14)
    box-shadow 6px 0 18px rgba(0, 0, 0, .18), inset -1px 0 0 rgba(255, 255, 255, .08)
    &::before
      background rgba(255, 255, 255, .16)
  .sidebar-bar
  .btns
    background linear-gradient(180deg, rgba(55, 76, 88, .74), rgba(30, 48, 59, .68))
    border-right 1px solid rgba(169, 204, 224, .12)
    box-shadow inset -1px 0 0 rgba(255, 255, 255, .05)
  .sidebar-panel
    background linear-gradient(180deg, rgba(50, 70, 82, .9), rgba(29, 47, 58, .86))
    border-right 1px solid rgba(169, 204, 224, .14)
    box-shadow 8px 0 20px rgba(0, 0, 0, .18), inset 1px 0 0 rgba(255, 255, 255, .07)
  .control-icon-wrap
    background rgba(255, 255, 255, .04)
    box-shadow inset 0 0 0 1px rgba(255, 255, 255, .04)
    &.active
      background linear-gradient(180deg, rgba(82, 142, 181, .36), rgba(47, 91, 118, .28))
      box-shadow inset 0 0 0 1px rgba(124, 212, 255, .22), 0 6px 14px rgba(0, 0, 0, .14)
      .control-icon
        color #7CD4FF
    &:hover
      background rgba(255, 255, 255, .1)
  .control-icon
  .control-icon-text
  .open-about-icon
    color #D6E3EA
