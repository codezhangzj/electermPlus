
.animate-fast
  animation-duration .2s
.sidebar-panel
  position absolute
  left 0
  top 0
  bottom 0
  z-index 200
  width 0
  overflow-y scroll
  background linear-gradient(180deg, rgba(252, 254, 255, .94), rgba(242, 248, 252, .88))
  backdrop-filter blur(26px) saturate(1.16)
  border-right 1px solid rgba(214, 226, 235, .86)
  box-shadow 12px 0 28px rgba(68, 86, 99, .10), inset 1px 0 0 rgba(255, 255, 255, .84)
  .item-list-unit:hover
    .list-item-remove
      display none !important
.sidebar-panel
  top 48px
.sidebar
  position absolute
  left 0
  top 0
  width 72px
  z-index 100
  bottom 0
  background linear-gradient(180deg, rgba(255, 255, 255, .94) 0%, rgba(244, 249, 252, .91) 48%, rgba(235, 244, 250, .9) 100%)
  box-shadow 8px 0 22px rgba(68, 86, 99, .12), inset -1px 0 0 rgba(214, 226, 235, .9)
  backdrop-filter blur(28px) saturate(1.18)
  &::before
    content ''
    position absolute
    left 8px
    right 8px
    top 12px
    height 142px
    border-radius 999px
    background linear-gradient(180deg, rgba(255, 255, 255, .82), rgba(255, 255, 255, 0))
    pointer-events none

  .item-list
    padding-right 0
.sidebar-pin-top
  position absolute
  left 0
  right 0
  top 0
  height 112px
.sidebar-panel-bookmarks
.sidebar-panel-history
  position absolute
  left 0
  right 0
  top 112px
  bottom 0
  overflow hidden
  display flex
  flex-direction column
  .sidebar-inner
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
  .history-header
    flex-shrink 0
    display flex
    align-items center
    border-bottom 1px solid var(--ios-border)
    position sticky
    top 0
    z-index 10
    background rgba(255, 255, 255, .86)
    backdrop-filter blur(18px)
    .history-clear-icon
      margin-left auto
      margin-right 0
      color #6D7E8A
      &:hover
        color #D95757
  .history-body
    flex 1
    overflow-y auto
    overflow-x hidden
.not-system-ui.is-mac
  .sidebar-bar
    margin-top 20px
.type-bookmarks
  .bookmarks-panel
    width 100%
.type-history
  .history-panel
    width 100%
.control-icon-text
  color #627685
  &:hover
    color #0A84FF
.control-icon-wrap
  width 38px
  height 38px
  margin 8px auto
  padding 0
  border-radius 10px
  text-align center
  display flex
  align-items center
  justify-content center
  transition background .16s ease, color .16s ease, transform .16s ease, box-shadow .16s ease
  &.active
    background linear-gradient(180deg, rgba(232, 244, 255, .98), rgba(209, 233, 255, .92))
    box-shadow inset 0 0 0 1px rgba(136, 194, 255, .55), 0 8px 18px rgba(10, 132, 255, .16)
    .control-icon
      color #0A84FF
  &:hover
    background rgba(232, 244, 255, .76)
    transform translateY(-1px)
  .control-icon
    color #6F8190
    cursor pointer
    transition color .16s ease
    &:hover
      color #0A84FF
.sidebar-list
  position absolute
  left 72px
  top 0
  bottom 0
  z-index 200
  width 0

.pinned
  .sidebar-list
    top 0
    .sidebar-panel
      top 0
      padding-top 48px
  .drag-handle
    display block
  .sidebar-panel
    .pinned
      color var(--success)
//btns
.btns
  background transparent
  border-color rgba(214, 226, 235, .74)
  .open-about-icon
    color #6F8190
    &:hover
      color #0A84FF

.btns .upgrade-icon
  color #25B36B
.close-info-modal
  cursor pointer
  &:hover
    color #13242F
.logo-filter
  filter none
.sidebar-inner
  padding-right 8px
