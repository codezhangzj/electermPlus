.ai-chat-container
  height 100%
  display flex
  flex-direction column
  background linear-gradient(135deg, rgba(255, 255, 255, .78), rgba(246, 250, 252, .70))
  color #172B36

.ai-chat-history
  flex-grow 1
  min-height 0
  padding 10px
  &::-webkit-scrollbar
    width 0
.ai-history-wrap
  width 100%
  overflow-y auto
  overflow-x hidden

.chat-history-item
  margin 8px 0
  padding 10px 12px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .76)
  box-shadow 0 8px 18px rgba(49, 66, 77, .08)
  .code-block
    border 1px solid rgba(255, 255, 255, .12)
    padding 8px
    border-radius var(--ios-radius)
    background var(--ios-terminal-dark)
    color #DDEBF0
    pre
      margin-bottom 0
    // .code-block-actions
    //   display block
    // &:hover
    //   .code-block-actions
    //     display block

.ai-chat-input
  position relative
  margin 10px
  padding 10px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .84)
  box-shadow var(--ios-shadow-soft)

  .ant-input
    padding-bottom 40px
    min-height 92px
    background #FFFFFF !important

  .ai-chat-terminals
    position absolute
    bottom 5px
    left 5px
    right 5px
    background transparent
    z-index 1
    font-size 16px

.code-block
  width 100%
  pre
    white-space pre-wrap
    word-wrap break-word
    overflow-x auto
    max-width 100%
  code
    white-space pre-wrap
    word-break break-all

.clear-ai-icon
  position relative
  &::after
    content '×'
    position absolute
    font-size 12px
    top 8px
    right -4px
    font-weight bold

.ai-stop-icon-square
  width 20px
  height 20px
  border-radius 6px
  display flex
  align-items center
  justify-content center
  font-size 10px
  background rgba(19, 36, 47, .08)

.ai-history-item-title
  display flex
  align-items center
  font-weight 700
  color #13242F
  .ai-stop-icon-square
    margin-left auto

.agent-tool-calls
  margin 8px 0

.agent-tool-call-card
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  margin-bottom 6px
  font-size 13px
  background rgba(255, 255, 255, .78)
  box-shadow 0 8px 18px rgba(49, 66, 77, .08)

.agent-tool-header
  display flex
  align-items center
  padding 8px 10px
  gap 6px

.agent-tool-name
  font-weight 700
  color #172B36

.agent-tool-tag
  margin-left auto

.agent-tool-status-running
  color #1890ff
  animation spin 1s linear infinite

.agent-tool-status-completed
  color #52c41a

.agent-tool-status-error
  color #ff4d4f

.agent-tool-detail
  padding 0 10px 10px
  border-top 1px solid var(--ios-border)

.agent-tool-args
  margin-top 6px

.agent-tool-result
  margin-top 6px

.agent-tool-label
  font-weight 700
  margin-bottom 4px
  font-size 12px
  color var(--text-color-2)

.agent-tool-pre
  background var(--ios-terminal-dark)
  color #DDEBF0
  padding 8px 10px
  border-radius var(--ios-radius)
  font-size 12px
  max-height 200px
  overflow-y auto
  white-space pre-wrap
  word-break break-all
  margin-bottom 0

.agent-tool-running
  border-color #1890ff

.agent-tool-completed
  border-color #52c41a

.agent-tool-error
  border-color #ff4d4f

@keyframes spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)
