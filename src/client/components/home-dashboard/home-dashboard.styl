    text-overflow ellipsis
    white-space nowrap

.home-resource-server-mark
  width 42px
  height 42px
  display grid
  place-items center
  border 1px solid rgba(47, 168, 214, .16)
  border-radius 8px
  background linear-gradient(160deg, rgba(235, 246, 255, .92), rgba(249, 252, 254, .82))
  color var(--ios-blue)
  font-size 23px

.home-resource-meta
  grid-column 1 / -1
  min-width 180px
  display flex
  align-items center
  justify-content space-between
  gap 7px
  span
    max-width 260px
