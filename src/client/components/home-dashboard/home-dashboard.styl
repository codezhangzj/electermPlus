.home-dashboard
  position absolute
  top 0
  left 72px
  right 0
  bottom 0
  z-index 90
  overflow hidden
  padding 18px
  color var(--ios-text)
  background var(--ios-bg-soft)
  -webkit-app-region drag
  *
    box-sizing border-box

.home-dashboard-inner
  position relative
  width 100%
  height 100%
  min-width 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden
  border 1px solid var(--ios-border-soft)
  border-radius 8px
  background rgba(255, 255, 255, .72)
  box-shadow 0 4px 12px rgba(49, 66, 77, .05)
  backdrop-filter var(--glass-sm)
  -webkit-app-region no-drag
  &::before
    content ''
    position absolute
    left 28px
    right 24px
    top 22px
    height 1px
    background linear-gradient(90deg, rgba(255, 255, 255, .92), rgba(255, 255, 255, .16))
    pointer-events none

.home-dashboard.resource-panel-pinned
  .home-dashboard-inner
    width calc(100% - 520px)
    transition width .18s ease

.home-header
  position relative
  z-index 1
  flex 0 0 auto
  min-height 74px
  display flex
  align-items center
  justify-content space-between
  gap 18px
  margin 18px 18px 14px
  padding 14px 16px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .58)
  box-shadow none
  backdrop-filter var(--glass-sm)
  h1
    margin 0
    color var(--ios-shell-dark)
    font-size 20px
    line-height 1.2
    font-weight 800
  p
    margin 6px 0 0
    max-width 760px
    color var(--ios-muted)
    font-size 13px

.home-header-actions
  display flex
  align-items center
  justify-content flex-end
  gap 8px
  .ant-btn
    height 30px
    padding 0 14px
    border-radius 8px !important
    font-size 12px
    font-weight 800
    box-shadow 0 4px 10px rgba(64, 81, 93, .08)
  .ant-btn-primary
    border-color #0A84FF !important
    background #0A84FF !important

.home-quick-grid
  position relative
  z-index 1
  flex 0 0 auto
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 12px
  margin 0 18px 14px

.home-quick-action
  min-width 0
  min-height 68px
  display flex
  align-items center
  gap 12px
  padding 12px
  border 1px solid rgba(218, 230, 238, .82)
  border-radius 8px
  background rgba(255, 255, 255, .58)
  color var(--ios-text)
  cursor pointer
  text-align left
  box-shadow none
  transition background .16s ease, border-color .16s ease
  &:hover
    border-color rgba(159, 204, 235, .85)
    background rgba(242, 249, 253, .92)
  &.primary
    border-color rgba(10, 132, 255, .28)
    background rgba(238, 247, 255, .82)
    .home-quick-action-icon
      color #FFFFFF
      background #0A84FF
  b
    display block
    overflow hidden
    color var(--ios-shell-dark)
    font-size 13px
    line-height 1.2
    text-overflow ellipsis
    white-space nowrap
  em
    display block
    margin-top 4px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    font-style normal
    text-overflow ellipsis
    white-space nowrap

.home-quick-action-icon
  flex 0 0 auto
  width 34px
  height 34px
  display grid
  place-items center
  border-radius 8px
  background rgba(235, 246, 255, .88)
  color var(--ios-blue)
  font-size 18px

.home-summary-grid
  position relative
  z-index 1
  flex 0 0 auto
  display grid
  grid-template-columns repeat(4, minmax(138px, 1fr))
  gap 12px
  margin 0 18px 14px

.home-summary-card
  position relative
  height 98px
  min-width 0
  padding 15px
  overflow hidden
  border 1px solid rgba(218, 230, 238, .82)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .9), rgba(246, 251, 253, .76))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .94)
  backdrop-filter var(--glass)
  &::before
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 3px
    background linear-gradient(90deg, var(--ios-blue), var(--ios-green))
    opacity .9
  small
    position absolute
    left 15px
    right 68px
    bottom 13px
    overflow hidden
    color #8A98A3
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  &.purple
    &::before
      background linear-gradient(90deg, var(--ios-purple), var(--ios-blue))
    .home-summary-icon
      color var(--ios-purple)
  &.warn
    &::before
      background linear-gradient(90deg, var(--ios-warn), var(--ios-red))
    .home-summary-icon
      color #D38422
  &.health
    .home-summary-icon
      color var(--ios-green)

.home-summary-meta
  position relative
  z-index 1
  display flex
  flex-direction column
  gap 7px
  span
    color var(--ios-muted)
    font-size 13px
  b
    color var(--ios-shell-dark)
    font-size 25px
    line-height 1
    font-weight 800

.home-summary-icon
  position absolute
  top 14px
  right 14px
  width 34px
  height 34px
  display grid
  place-items center
  border-radius 8px
  background rgba(235, 246, 255, .82)
  color #2D88C7
  font-size 18px

.home-toolbar
  position relative
  z-index 1
  flex 0 0 auto
  height 46px
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 0 18px 14px
  padding 8px 12px
  border 1px solid rgba(218, 230, 238, .84)
  border-radius 8px
  background rgba(255, 255, 255, .58)
  box-shadow none
  backdrop-filter var(--glass-sm)

.home-group-tabs
  min-width 0
  display flex
  align-items center
  gap 8px
  overflow hidden
  button
    flex 0 0 auto
    height 26px
    padding 0 16px
    border 0
    border-radius 8px
    background rgba(239, 246, 251, .92)
    color var(--ios-muted)
    cursor pointer
    font-size 12px
    font-weight 800
    white-space nowrap
    &.active
      color #FFFFFF
      background #0A84FF
      box-shadow 0 6px 14px rgba(10, 132, 255, .18)
    &:hover:not(.active)
      color #36505D
      background #E8F2FA

.home-search
  width 220px
  flex 0 0 220px
  .ant-input-affix-wrapper
    height 28px
    border-color #DCE8F0 !important
    background #F8FBFD !important
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-body-grid
  position relative
  z-index 1
  flex 1 1 auto
  min-height 0
  display grid
  grid-template-columns minmax(0, 1fr) 292px
  gap 14px
  margin 0 18px 18px
  overflow hidden

.home-groups
  min-width 0
  min-height 0
  overflow auto
  padding 2px 6px 8px 0
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-group
  margin-bottom 16px

.home-group-head
  display flex
  align-items baseline
  gap 12px
  margin 0 0 10px
  h2
    display flex
    align-items center
    gap 7px
    margin 0
    color var(--ios-shell-dark)
    font-size 16px
    font-weight 800
  span
    color var(--ios-muted)
    font-size 12px

.home-server-grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(300px, 1fr))
  gap 14px

.home-server-card
  position relative
  min-width 0
  min-height 164px
  padding 15px 15px 54px
  overflow hidden
  cursor pointer
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .7)
  box-shadow 0 3px 10px rgba(64, 81, 93, .05)
  backdrop-filter var(--glass-sm)
  transition background .16s ease, border-color .16s ease
  &:hover
    border-color rgba(159, 204, 235, .86)
    background rgba(255, 255, 255, .92)

.home-server-card-top
  position relative
  z-index 1
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px
  margin-bottom 12px

.home-server-title-wrap
  min-width 0
  flex 1 1 auto
  display flex
  align-items flex-start
  gap 10px
  > div
    min-width 0
    flex 1 1 auto

.home-server-avatar
  flex 0 0 auto
  width 34px
  height 34px
  display grid
  place-items center
  border 1px solid rgba(47, 168, 214, .16)
  border-radius 8px
  background linear-gradient(160deg, rgba(235, 246, 255, .92), rgba(249, 252, 254, .82))
  color var(--ios-blue)
  font-size 14px
  font-weight 800

.home-server-title
  max-width 100%
  overflow hidden
  color var(--ios-shell-dark)
  font-size 15px
  font-weight 800
  text-overflow ellipsis
  white-space nowrap

.home-server-sub
  margin-top 3px
  max-width 100%
  overflow hidden
  color #8A98A3
  font-size 12px
  text-overflow ellipsis
  white-space nowrap

.home-server-status
  flex 0 0 auto
  max-width 58px
  height 22px
  line-height 22px
  padding 0 9px
  overflow hidden
  border-radius 7px
  font-size 11px
  font-weight 800
  text-overflow ellipsis
  white-space nowrap
  &.ready
    color var(--ios-green)
    background rgba(234, 248, 240, .92)

.home-server-host-row
  position relative
  z-index 1
  display flex
  align-items center
  gap 7px
  min-width 0
  height 34px
  margin 0 42px 12px 0
  padding 0 6px 0 11px
  border 1px solid rgba(220, 232, 240, .82)
  border-radius 8px
  background rgba(247, 251, 253, .84)
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-server-host
  flex 1 1 auto
  min-width 0
  overflow hidden
  color #36505D
  font-family 'SF Mono', Menlo, Consolas, monospace
  font-size 13px
  font-weight 700
  text-overflow ellipsis
  white-space nowrap

.home-copy-btn
  flex 0 0 auto
  display inline-flex
  align-items center
  justify-content center
  width 24px
  height 24px
  border 0
  border-radius 7px
  background #EEF6FB
  color #526471
  cursor pointer
  &:hover
    color var(--ios-shell-dark)
    background #E2F0FA

.home-resource-btn
  position absolute
  right 59px
  bottom 15px
  width 36px
  height 32px
  display inline-flex
  align-items center
  justify-content center
  border 1px solid rgba(220, 232, 240, .9)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(239, 247, 252, .82))
  color var(--ios-blue)
  cursor pointer
  box-shadow 0 8px 16px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .92)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease
  svg
    font-size 16px
  &:hover
    transform translateY(-1px)
    border-color rgba(159, 204, 235, .86)
    color #0076E8
    box-shadow 0 12px 20px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .96)

.home-card-notes
  position relative
  z-index 1
  display flex
  align-items center
  min-height 34px
  color var(--ios-muted)
  font-size 12px
  line-height 1.45

.home-connect-btn
  position absolute
  right 15px
  bottom 15px
  width 36px
  min-width 36px
  height 32px
  padding 0 !important
  border-radius 8px !important
  border-color #0A84FF !important
  background linear-gradient(180deg, #2F95FF, #0A7AF0) !important
  color #FFFFFF !important
  box-shadow 0 10px 18px rgba(10, 132, 255, .22), inset 0 1px 0 rgba(255, 255, 255, .32)
  .ant-btn-icon
    display inline-flex
    align-items center
    justify-content center
    margin 0
  &:hover
    border-color #0076E8 !important
    background linear-gradient(180deg, #3EA0FF, #0076E8) !important
    box-shadow 0 12px 22px rgba(10, 132, 255, .28), inset 0 1px 0 rgba(255, 255, 255, .36)
  > span:not(.ant-btn-icon)
    display none

.home-connect-icon
  position relative
  width 20px
  height 20px
  display inline-flex
  align-items center
  justify-content center
  color #FFFFFF

.home-connect-icon-node
  position absolute
  left 1px
  top 2px
  font-size 14px
  opacity .95

.home-connect-icon-arrow
  position absolute
  right 0
  bottom 1px
  font-size 14px
  filter drop-shadow(0 1px 1px rgba(0, 70, 130, .2))

.home-health-panel
  min-width 0
  min-height 0
  overflow auto
  padding 2px 2px 8px
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-workspace-panel
  position relative
  min-height 0
  overflow hidden
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 10px
  background rgba(255, 255, 255, .7)
  box-shadow 0 3px 10px rgba(64, 81, 93, .05)
  backdrop-filter var(--glass-sm)

.home-rail-section
  padding 15px 14px
  & + &
    border-top 1px solid rgba(218, 230, 238, .78)
  &.workspace
    background linear-gradient(135deg, rgba(239, 247, 252, .76), rgba(250, 252, 253, .7))

.home-section-icon
  width 26px
  height 26px
  display flex
  align-items center
  justify-content center
  border-radius 7px
  background rgba(10, 132, 255, .1)
  color var(--ios-blue)
  font-size 13px
  &.recent
    background rgba(115, 87, 171, .1)
    color var(--ios-purple)
  &.workspace
    background rgba(49, 193, 118, .1)
    color var(--ios-green)
  &.abnormal
    background rgba(226, 94, 84, .1)
    color var(--ios-red)

.home-health-title
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin-bottom 12px
  > div
    min-width 0
    display flex
    align-items center
    gap 9px
  b
    color var(--ios-shell-dark)
    font-size 13px
  > span
    flex 0 0 auto
    color #8A98A3
    font-size 11px
    &.danger
      color var(--ios-red)
      font-weight 800
    &.healthy
      color var(--ios-green)
      font-weight 800

.home-side-list
  display flex
  flex-direction column
  gap 4px

.home-side-item
  width 100%
  display flex
  align-items center
  gap 9px
  min-width 0
  padding 8px 9px
  border 0
  border-radius 8px
  background transparent
  color inherit
  cursor pointer
  font inherit
  text-align left
  transition background .16s ease, transform .16s ease
  &:hover
    transform translateX(2px)
    background rgba(235, 245, 251, .86)
    .home-side-arrow
      opacity 1
      transform translateX(0)
  &:focus-visible
    outline 2px solid rgba(10, 132, 255, .42)
    outline-offset -2px
  > div
  .home-side-main > div
    flex 1 1 auto
    min-width 0
    b
      display block
      overflow hidden
      color var(--ios-shell-dark)
      font-size 12px
      text-overflow ellipsis
      white-space nowrap
    span
      display block
      margin-top 3px
      overflow hidden
      color var(--ios-muted)
      font-size 12px
      text-overflow ellipsis
      white-space nowrap
  &.active-session
    padding 0 5px 0 0

.home-side-main
  flex 1 1 auto
  min-width 0
  display flex
  align-items center
  gap 9px
  padding 8px 4px 8px 9px
  border 0
  background transparent
  color inherit
  cursor pointer
  font inherit
  text-align left
  &:focus-visible
    outline 2px solid rgba(10, 132, 255, .42)
    outline-offset -2px
    border-radius 7px

.home-side-close
  flex 0 0 auto
  width 24px
  height 24px
  display flex
  align-items center
  justify-content center
  padding 0
  border 0
  border-radius 7px
  background transparent
  color #8D9AA4
  cursor pointer
  opacity .72
  transition color .16s ease, background .16s ease, opacity .16s ease
  svg
    font-size 11px
  &:hover
    color var(--ios-red)
    background rgba(226, 94, 84, .1)
    opacity 1
  &:focus-visible
    outline 2px solid rgba(226, 94, 84, .38)
    outline-offset -2px
    opacity 1

.home-session-dot
  flex 0 0 auto
  width 8px
  height 8px
  border 2px solid rgba(138, 152, 163, .3)
  border-radius 50%
  background #A6B1B9
  box-shadow 0 0 0 3px rgba(138, 152, 163, .08)
  &.online
    border-color rgba(49, 193, 118, .22)
    background var(--ios-green)
    box-shadow 0 0 0 3px rgba(49, 193, 118, .1)

.home-side-item-icon
  flex 0 0 auto
  color var(--ios-purple)
  font-size 13px
  &.error
    color var(--ios-red)

.home-side-item.error-session
  background rgba(253, 236, 233, .56)
  &:hover
    background rgba(253, 236, 233, .86)

.home-panel-healthy
  padding 12px 9px
  border 1px solid rgba(49, 193, 118, .18)
  border-radius 8px
  background rgba(234, 248, 240, .58)
  color var(--ios-green)
  font-size 11px
  font-weight 800
  text-align center

.home-side-arrow
  flex 0 0 auto
  color #9EABB4 !important
  font-size 10px
  opacity 0
  transform translateX(-3px)
  transition opacity .16s ease, transform .16s ease

.home-group-status-list
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 7px

.home-workspace-metric
  min-width 0
  padding 10px 6px
  border-radius 8px
  background rgba(255, 255, 255, .68)
  text-align center
  span
    display block
    margin-top 5px
    color var(--ios-muted)
    font-size 11px
  b
    display block
    color var(--ios-shell-dark)
    font-size 19px
    line-height 1

.home-side-button
  margin-top 10px
  height 32px
  border-radius 8px !important
  font-size 11px
  font-weight 800

.home-panel-empty
  padding 12px 9px
  border 1px dashed rgba(205, 217, 226, .9)
  border-radius 8px
  color #8A98A3
  font-size 11px
  text-align center

.home-empty
  flex 1 1 auto
  min-height 0
  display flex
  flex-direction column
  align-items center
  justify-content center
  margin 0 18px 18px
  border 1px dashed #CDD9E2
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .86), rgba(247, 251, 253, .74))
