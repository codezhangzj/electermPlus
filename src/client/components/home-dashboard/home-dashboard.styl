.home-dashboard
  position absolute
  top 0
  left 72px
  right 0
  bottom 0
  z-index 90
  overflow hidden
  padding 18px
  color var(--ios-text)
  background linear-gradient(135deg, var(--ios-bg) 0%, var(--ios-bg-soft) 48%, #F7F4EF 100%)
  -webkit-app-region drag
  *
    box-sizing border-box

.home-dashboard-inner
  position relative
  width 100%
  height 100%
  min-width 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden
  border 1px solid var(--ios-border-soft)
  border-radius 8px
  background linear-gradient(145deg, rgba(255, 255, 255, .9), rgba(246, 250, 252, .76))
  box-shadow 0 14px 28px rgba(49, 66, 77, .09), inset 0 1px 0 rgba(255, 255, 255, .82)
  backdrop-filter blur(28px) saturate(1.08)
  -webkit-app-region no-drag
  &::before
    content ''
    position absolute
    left 28px
    right 24px
    top 22px
    height 1px
    background linear-gradient(90deg, rgba(255, 255, 255, .92), rgba(255, 255, 255, .16))
    pointer-events none

.home-header
  position relative
  z-index 1
  flex 0 0 auto
  min-height 74px
  display flex
  align-items center
  justify-content space-between
  gap 18px
  margin 18px 18px 14px
  padding 14px 16px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(247, 251, 253, .74))
  box-shadow 0 10px 24px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter blur(22px) saturate(1.08)
  h1
    margin 0
    color var(--ios-shell-dark)
    font-size 20px
    line-height 1.2
    font-weight 800
  p
    margin 6px 0 0
    max-width 760px
    color var(--ios-muted)
    font-size 13px

.home-header-actions
  display flex
  align-items center
  justify-content flex-end
  gap 8px
  .ant-btn
    height 30px
    padding 0 14px
    border-radius 8px !important
    font-size 12px
    font-weight 800
    box-shadow 0 4px 10px rgba(64, 81, 93, .08)
  .ant-btn-primary
    border-color #0A84FF !important
    background #0A84FF !important

.home-quick-grid
  position relative
  z-index 1
  flex 0 0 auto
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 12px
  margin 0 18px 14px

.home-quick-action
  min-width 0
  min-height 68px
  display flex
  align-items center
  gap 12px
  padding 12px
  border 1px solid rgba(218, 230, 238, .82)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .88), rgba(247, 251, 253, .74))
  color var(--ios-text)
  cursor pointer
  text-align left
  box-shadow 0 8px 18px rgba(64, 81, 93, .07), inset 0 1px 0 rgba(255, 255, 255, .92)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease
  &:hover
    transform translateY(-1px)
    border-color rgba(159, 204, 235, .85)
    box-shadow 0 13px 24px rgba(64, 81, 93, .1), inset 0 1px 0 rgba(255, 255, 255, .96)
  &.primary
    border-color rgba(10, 132, 255, .28)
    background linear-gradient(160deg, rgba(255, 255, 255, .94), rgba(238, 247, 255, .82))
    .home-quick-action-icon
      color #FFFFFF
      background #0A84FF
  b
    display block
    overflow hidden
    color var(--ios-shell-dark)
    font-size 13px
    line-height 1.2
    text-overflow ellipsis
    white-space nowrap
  em
    display block
    margin-top 4px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    font-style normal
    text-overflow ellipsis
    white-space nowrap

.home-quick-action-icon
  flex 0 0 auto
  width 34px
  height 34px
  display grid
  place-items center
  border-radius 8px
  background rgba(235, 246, 255, .88)
  color var(--ios-blue)
  font-size 18px

.home-summary-grid
  position relative
  z-index 1
  flex 0 0 auto
  display grid
  grid-template-columns repeat(4, minmax(138px, 1fr))
  gap 12px
  margin 0 18px 14px

.home-summary-card
  position relative
  height 98px
  min-width 0
  padding 15px
  overflow hidden
  border 1px solid rgba(218, 230, 238, .82)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .9), rgba(246, 251, 253, .76))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .94)
  backdrop-filter blur(22px) saturate(1.1)
  &::before
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 3px
    background linear-gradient(90deg, var(--ios-blue), var(--ios-green))
    opacity .9
  small
    position absolute
    left 15px
    right 68px
    bottom 13px
    overflow hidden
    color #8A98A3
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  &.purple
    &::before
      background linear-gradient(90deg, var(--ios-purple), var(--ios-blue))
    .home-summary-icon
      color var(--ios-purple)
  &.warn
    &::before
      background linear-gradient(90deg, var(--ios-warn), var(--ios-red))
    .home-summary-icon
      color #D38422
  &.health
    .home-summary-icon
      color var(--ios-green)

.home-summary-meta
  position relative
  z-index 1
  display flex
  flex-direction column
  gap 7px
  span
    color var(--ios-muted)
    font-size 13px
  b
    color var(--ios-shell-dark)
    font-size 25px
    line-height 1
    font-weight 800

.home-summary-icon
  position absolute
  top 14px
  right 14px
  width 34px
  height 34px
  display grid
  place-items center
  border-radius 8px
  background rgba(235, 246, 255, .82)
  color #2D88C7
  font-size 18px

.home-toolbar
  position relative
  z-index 1
  flex 0 0 auto
  height 46px
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 0 18px 14px
  padding 8px 12px
  border 1px solid rgba(218, 230, 238, .84)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .84), rgba(247, 251, 253, .74))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .9)
  backdrop-filter blur(22px) saturate(1.08)

.home-group-tabs
  min-width 0
  display flex
  align-items center
  gap 8px
  overflow hidden
  button
    flex 0 0 auto
    height 26px
    padding 0 16px
    border 0
    border-radius 8px
    background rgba(239, 246, 251, .92)
    color var(--ios-muted)
    cursor pointer
    font-size 12px
    font-weight 800
    white-space nowrap
    &.active
      color #FFFFFF
      background #0A84FF
      box-shadow 0 6px 14px rgba(10, 132, 255, .18)
    &:hover:not(.active)
      color #36505D
      background #E8F2FA

.home-search
  width 220px
  flex 0 0 220px
  .ant-input-affix-wrapper
    height 28px
    border-color #DCE8F0 !important
    background #F8FBFD !important
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-body-grid
  position relative
  z-index 1
  flex 1 1 auto
  min-height 0
  display grid
  grid-template-columns minmax(0, 1fr) 292px
  gap 14px
  margin 0 18px 18px
  overflow hidden

.home-groups
  min-width 0
  min-height 0
  overflow auto
  padding 2px 6px 8px 0
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-group
  margin-bottom 16px

.home-group-head
  display flex
  align-items baseline
  gap 12px
  margin 0 0 10px
  h2
    margin 0
    color var(--ios-shell-dark)
    font-size 16px
    font-weight 800
  span
    color var(--ios-muted)
    font-size 12px

.home-server-grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(300px, 1fr))
  gap 14px

.home-server-card
  position relative
  min-width 0
  min-height 164px
  padding 15px 15px 54px
  overflow hidden
  cursor pointer
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .94), rgba(247, 251, 253, .8))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .96)
  backdrop-filter blur(22px) saturate(1.1)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease
  &::before
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 3px
    background linear-gradient(90deg, var(--ios-blue), var(--ios-green))
  &:hover
    transform translateY(-1px)
    border-color rgba(159, 204, 235, .86)
    box-shadow 0 16px 30px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .96)

.home-server-card-top
  position relative
  z-index 1
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px
  margin-bottom 12px

.home-server-title-wrap
  min-width 0
  flex 1 1 auto
  display flex
  align-items flex-start
  gap 10px
  > div
    min-width 0
    flex 1 1 auto

.home-server-avatar
  flex 0 0 auto
  width 34px
  height 34px
  display grid
  place-items center
  border 1px solid rgba(47, 168, 214, .16)
  border-radius 8px
  background linear-gradient(160deg, rgba(235, 246, 255, .92), rgba(249, 252, 254, .82))
  color var(--ios-blue)
  font-size 14px
  font-weight 800

.home-server-title
  max-width 100%
  overflow hidden
  color var(--ios-shell-dark)
  font-size 15px
  font-weight 800
  text-overflow ellipsis
  white-space nowrap

.home-server-sub
  margin-top 3px
  max-width 100%
  overflow hidden
  color #8A98A3
  font-size 12px
  text-overflow ellipsis
  white-space nowrap

.home-server-status
  flex 0 0 auto
  max-width 58px
  height 22px
  line-height 22px
  padding 0 9px
  overflow hidden
  border-radius 7px
  font-size 11px
  font-weight 800
  text-overflow ellipsis
  white-space nowrap
  &.ready
    color var(--ios-green)
    background rgba(234, 248, 240, .92)

.home-server-host-row
  position relative
  z-index 1
  display flex
  align-items center
  gap 7px
  min-width 0
  height 34px
  margin 0 42px 12px 0
  padding 0 6px 0 11px
  border 1px solid rgba(220, 232, 240, .82)
  border-radius 8px
  background rgba(247, 251, 253, .84)
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-server-host
  flex 1 1 auto
  min-width 0
  overflow hidden
  color #36505D
  font-family 'SF Mono', Menlo, Consolas, monospace
  font-size 13px
  font-weight 700
  text-overflow ellipsis
  white-space nowrap

.home-copy-btn
  flex 0 0 auto
  display inline-flex
  align-items center
  justify-content center
  width 24px
  height 24px
  border 0
  border-radius 7px
  background #EEF6FB
  color #526471
  cursor pointer
  &:hover
    color var(--ios-shell-dark)
    background #E2F0FA

.home-card-notes
  position relative
  z-index 1
  display flex
  align-items center
  min-height 34px
  color var(--ios-muted)
  font-size 12px
  line-height 1.45

.home-connect-btn
  position absolute
  right 15px
  bottom 15px
  width 36px
  min-width 36px
  height 32px
  padding 0 !important
  border-radius 8px !important
  border-color #0A84FF !important
  background linear-gradient(180deg, #2F95FF, #0A7AF0) !important
  color #FFFFFF !important
  box-shadow 0 10px 18px rgba(10, 132, 255, .22), inset 0 1px 0 rgba(255, 255, 255, .32)
  .ant-btn-icon
    display inline-flex
    align-items center
    justify-content center
    margin 0
  &:hover
    border-color #0076E8 !important
    background linear-gradient(180deg, #3EA0FF, #0076E8) !important
    box-shadow 0 12px 22px rgba(10, 132, 255, .28), inset 0 1px 0 rgba(255, 255, 255, .36)
  > span:not(.ant-btn-icon)
    display none

.home-connect-icon
  position relative
  width 20px
  height 20px
  display inline-flex
  align-items center
  justify-content center
  color #FFFFFF

.home-connect-icon-node
  position absolute
  left 1px
  top 2px
  font-size 14px
  opacity .95

.home-connect-icon-arrow
  position absolute
  right 0
  bottom 1px
  font-size 14px
  filter drop-shadow(0 1px 1px rgba(0, 70, 130, .2))

.home-health-panel
  min-width 0
  min-height 0
  display flex
  flex-direction column
  gap 12px
  overflow auto
  padding 2px 2px 8px
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-health-card
  position relative
  min-height 0
  padding 14px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .78))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .94)
  backdrop-filter blur(22px) saturate(1.1)
  &.primary
    min-height 96px
    display flex
    align-items center
    justify-content space-between
    span
      display block
      color var(--ios-muted)
      font-size 13px
    b
      display block
      margin-top 8px
      color var(--ios-shell-dark)
      font-size 30px
      line-height 1

.home-health-session-icon
  width 48px
  height 48px
  display flex
  align-items center
  justify-content center
  border 1px solid rgba(47, 168, 214, .18)
  border-radius 8px
  background linear-gradient(160deg, rgba(235, 246, 255, .92), rgba(249, 252, 254, .82))
  color var(--ios-blue)
  font-size 24px

.home-health-title
  display flex
  align-items baseline
  justify-content space-between
  gap 12px
  margin-bottom 10px
  b
    color var(--ios-shell-dark)
    font-size 14px
  span
    color #8A98A3
    font-size 12px

.home-side-list
  display flex
  flex-direction column
  gap 8px

.home-side-item
  display flex
  align-items flex-start
  gap 10px
  min-width 0
  padding 8px
  border-radius 8px
  background rgba(248, 251, 253, .72)
  svg
    flex 0 0 auto
    margin-top 2px
    color var(--ios-blue)
  div
    min-width 0
  b
    display block
    overflow hidden
    color var(--ios-shell-dark)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  span
    display block
    margin-top 3px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

.home-group-status-list
  display grid
  grid-template-columns 1fr 1fr
  gap 10px

.home-workspace-metric
  padding 9px
  border-radius 8px
  background rgba(248, 251, 253, .72)
  span
    display block
    color var(--ios-muted)
    font-size 12px
  b
    display block
    margin-top 6px
    color var(--ios-shell-dark)
    font-size 21px
    line-height 1

.home-side-button
  margin-top 12px
  height 30px
  border-radius 8px !important
  font-size 12px
  font-weight 800

.home-panel-empty
  color #8A98A3
  font-size 12px

.home-empty
  flex 1 1 auto
  min-height 0
  display flex
  flex-direction column
  align-items center
  justify-content center
  margin 0 18px 18px
  border 1px dashed #CDD9E2
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .86), rgba(247, 251, 253, .74))
  color #657582
  text-align center
  backdrop-filter blur(18px)
  svg
    color var(--ios-blue)
    font-size 42px
  h2
    margin 18px 0 6px
    color var(--ios-shell-dark)
  p
    margin 0 0 18px

.app-theme-defaultDark
  .home-dashboard
    color #DDEBF0
    background linear-gradient(135deg, #152631 0%, #1D3340 54%, #253D4A 100%)
  .home-dashboard-inner
    border-color rgba(169, 204, 224, .14)
    background linear-gradient(145deg, rgba(43, 63, 76, .88), rgba(25, 41, 51, .76))
    box-shadow 0 14px 28px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255, 255, 255, .07)
    &::before
      background linear-gradient(90deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, .04))
  .home-header
  .home-quick-action
  .home-summary-card
  .home-toolbar
  .home-server-card
  .home-health-card
  .home-empty
    border-color rgba(169, 204, 224, .16)
    background linear-gradient(160deg, rgba(43, 63, 76, .88), rgba(25, 41, 51, .76))
    box-shadow 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .07)
  .home-header h1
  .home-quick-action b
  .home-summary-meta b
  .home-group-head h2
  .home-server-title
  .home-health-title b
  .home-side-item b
  .home-workspace-metric b
  .home-empty h2
    color #F4FAFC
  .home-header p
  .home-quick-action em
  .home-summary-meta span
  .home-summary-card small
  .home-group-head span
  .home-server-sub
  .home-card-notes
  .home-health-title span
  .home-side-item span
  .home-workspace-metric span
  .home-panel-empty
  .home-empty
    color #95AAB4
  .home-quick-action-icon
  .home-summary-icon
  .home-server-avatar
  .home-health-session-icon
    border-color rgba(124, 212, 255, .18)
    background linear-gradient(160deg, rgba(82, 142, 181, .22), rgba(255, 255, 255, .05))
    color #7CD4FF
  .home-quick-action.primary
    border-color rgba(124, 212, 255, .24)
    background linear-gradient(160deg, rgba(56, 90, 110, .88), rgba(30, 52, 64, .8))
  .home-group-tabs button
    color #95AAB4
    background rgba(255, 255, 255, .06)
    &.active
      color #FFFFFF
      background #0A84FF
      box-shadow 0 6px 14px rgba(10, 132, 255, .18)
    &:hover:not(.active)
      color #FFFFFF
      background rgba(255, 255, 255, .1)
  .home-search
    .ant-input-affix-wrapper
      color #DDEBF0 !important
      border-color rgba(169, 204, 224, .16) !important
      background rgba(255, 255, 255, .07) !important
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .05)
  .home-server-host-row
    border-color rgba(169, 204, 224, .16)
    background rgba(255, 255, 255, .06)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .05)
  .home-server-host
    color #DDEBF0
  .home-copy-btn
  .home-side-item
  .home-workspace-metric
    background rgba(255, 255, 255, .06)
    color #D6E3EA
  .home-copy-btn:hover
    color #FFFFFF
    background rgba(255, 255, 255, .1)
  .home-server-status.ready
    color #98F0B6
    background rgba(49, 193, 118, .16)
  .home-side-button
    color #D6E3EA
    background rgba(255, 255, 255, .07)
    border-color rgba(169, 204, 224, .16)

.app-theme-defaultGlass
  .home-dashboard
    background linear-gradient(135deg, #DFEAF0 0%, #EEF6F9 100%)
  .home-dashboard-inner
  .home-header
  .home-quick-action
  .home-summary-card
  .home-toolbar
  .home-server-card
  .home-health-card
  .home-empty
    border-color rgba(255, 255, 255, .72)
    background linear-gradient(160deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    box-shadow 0 10px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .7)
  .home-quick-action-icon
  .home-summary-icon
  .home-server-avatar
  .home-health-session-icon
    border-color rgba(255, 255, 255, .7)
    background rgba(255, 255, 255, .54)
  .home-group-tabs button
  .home-server-host-row
  .home-side-item
  .home-workspace-metric
  .home-copy-btn
    background rgba(255, 255, 255, .54)
  .home-group-tabs button.active
    color #FFFFFF
    background #0A84FF
    box-shadow 0 6px 14px rgba(10, 132, 255, .18)
  .home-search
    .ant-input-affix-wrapper
      border-color rgba(255, 255, 255, .72) !important
      background rgba(255, 255, 255, .54) !important

@media (max-width 1180px)
  .home-body-grid
    grid-template-columns 1fr
  .home-health-panel
    display none

@media (max-width 900px)
  .home-quick-grid
  .home-summary-grid
    grid-template-columns repeat(2, minmax(150px, 1fr))
  .home-header
    min-height auto
    align-items flex-start
    flex-direction column
  .home-toolbar
    height auto
    align-items flex-start
    flex-direction column
  .home-search
    width 100%
    flex auto
  .home-server-grid
    grid-template-columns 1fr

@media (max-width 560px)
  .home-dashboard
    left 0
    padding 12px
  .home-quick-grid
  .home-summary-grid
    grid-template-columns 1fr
  .home-server-grid
    grid-template-columns minmax(0, 1fr)
  .home-header-actions
    width 100%
    justify-content flex-start
    flex-wrap wrap
