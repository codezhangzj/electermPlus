.home-resource-metric-tile
  min-width 0
  min-height 158px
  padding 13px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .68)
  box-shadow none
  em
    display block
    margin-top 10px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    font-style normal
    text-overflow ellipsis
    white-space nowrap
  &.green .home-resource-metric-head span
    color var(--ios-green)
  &.blue .home-resource-metric-head span
    color var(--ios-blue)
  &.warn .home-resource-metric-head span
    color var(--ios-warn)
  &.danger .home-resource-metric-head span
    color var(--ios-red)

.home-resource-metric-head
  display flex
  align-items center
  justify-content space-between
  gap 10px
  b
    color var(--ios-muted)
    font-size 12px
    font-weight 800
  span
    width 30px
    height 30px
    display grid
    place-items center
    border-radius 8px
    background rgba(235, 246, 255, .82)

.home-resource-gauge-wrap
  position relative
  width 116px
  height 116px
  display grid
  place-items center
  margin 2px auto 0
  strong
    position absolute
    left 0
    right 0
    top 43px
    color var(--ios-shell-dark)
    font-size 25px
    line-height 1
    font-weight 800
    text-align center

.home-resource-gauge
  width 116px
  height 116px
  transform rotate(-90deg)
  circle
    fill none
    stroke-width 12
  .home-resource-gauge-track
    stroke rgba(224, 236, 244, .92)
  .home-resource-gauge-value
    stroke-linecap round
    transition stroke-dasharray .28s ease
    &.green
      stroke var(--ios-green)
    &.blue
      stroke var(--ios-blue)
    &.warn
      stroke var(--ios-warn)
    &.danger
      stroke var(--ios-red)

.home-resource-error
  display flex
  align-items center
  gap 8px
  margin -2px 0 14px
  padding 10px 12px
  border 1px solid rgba(226, 94, 84, .2)
  border-radius 8px
  background rgba(253, 236, 233, .82)
  color var(--ios-red)
  font-size 12px
  font-weight 700

.home-resource-alert-summary
  display flex
  align-items center
  gap 10px
  margin -2px 0 14px
  padding 10px 12px
  border 1px solid rgba(49, 193, 118, .18)
  border-radius 8px
  background rgba(234, 248, 240, .58)
  color var(--ios-green)
  svg
    flex 0 0 auto
    font-size 16px
  b
    display block
    font-size 12px
    font-weight 800
  span
    display block
    margin-top 2px
    color var(--ios-muted)
    font-size 12px
  &.warn
    border-color rgba(240, 179, 90, .26)
    background rgba(255, 246, 230, .7)
    color #D38422
  &.danger
    border-color rgba(226, 94, 84, .24)
    background rgba(253, 236, 233, .7)
    color var(--ios-red)
    animation home-resource-alert-pulse 2s ease-in-out infinite
    svg
      animation home-resource-alert-bell 2s ease-in-out infinite

@keyframes home-resource-alert-pulse
  0%, 100%
    box-shadow 0 0 0 0 rgba(226, 94, 84, 0)
  50%
    box-shadow 0 0 0 4px rgba(226, 94, 84, .14)

@keyframes home-resource-alert-bell
  0%, 92%, 100%
    transform rotate(0deg)
  94%
    transform rotate(-12deg)
  96%
    transform rotate(10deg)
  98%
    transform rotate(-6deg)

.home-resource-alert-settings
  display flex
  flex-direction column
  gap 10px
  min-width 200px
  .home-resource-alert-row
    display flex
    align-items center
    justify-content space-between
    gap 12px
    font-size 12px
    color var(--ios-text)
    > span
      display inline-flex
      align-items center
      gap 6px

.home-resource-detail-grid
  display grid
  grid-template-columns minmax(0, 1fr)
  gap 12px

.home-resource-panel
  min-width 0
  padding 13px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .68)
  box-shadow none
  &.wide
    grid-column 1 / -1

.home-resource-section-title
  display flex
  align-items baseline
  justify-content space-between
  gap 10px
  margin-bottom 10px
  b
    display inline-flex
    align-items center
    gap 6px
    color var(--ios-shell-dark)
    font-size 13px
    font-weight 800
  span
    color #8A98A3
    font-size 12px

.home-resource-trend-panel
  min-height 236px

.home-resource-trend-chart
  height 150px
  overflow hidden
  border 1px solid rgba(226, 236, 243, .76)
  border-radius 8px
  background linear-gradient(180deg, rgba(248, 252, 254, .82), rgba(242, 248, 252, .62))
  svg
    display block
    width 100%
    height 100%
  line
    stroke rgba(180, 198, 210, .42)
    stroke-width 1
  polyline
    fill none
    stroke-width 3
    stroke-linejoin round
    stroke-linecap round
    filter drop-shadow(0 3px 5px rgba(64, 81, 93, .12))
    &.cpu
      stroke var(--ios-blue)
    &.mem
      stroke var(--ios-green)
    &.disk
      stroke var(--ios-warn)
    &.network
      stroke var(--ios-purple)

.home-resource-chart-legend
  display flex
  align-items center
  gap 10px
  flex-wrap wrap
  margin-top 10px
  span
    display inline-flex
    align-items center
    gap 6px
    min-width 0
    color var(--ios-muted)
    font-size 12px
    font-weight 800
    &::before
      content ''
      width 10px
      height 10px
      border-radius 3px
      background var(--ios-blue)
    &.cpu::before
      background var(--ios-blue)
    &.mem::before
      background var(--ios-green)
    &.disk::before
      background var(--ios-warn)
    &.network::before
      background var(--ios-purple)
  b
    color var(--ios-shell-dark)
    font-size 12px

.home-resource-placeholder
  min-height 88px
  display grid
  place-items center
  border 1px dashed rgba(205, 217, 226, .84)
  border-radius 8px
  color #8A98A3
  font-size 12px

.home-resource-disk-row
  display grid
  grid-template-columns minmax(0, 1fr) 120px
  gap 10px
  align-items center
  padding 9px
  border-radius 8px
  background rgba(248, 251, 253, .72)
  & + &
