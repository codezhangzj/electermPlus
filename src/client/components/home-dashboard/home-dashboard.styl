.home-dashboard
  position absolute
  top 0
  left 72px
  right 0
  bottom 0
  z-index 90
  overflow hidden
  padding 18px
  color #10222D
  background linear-gradient(135deg, #F9FBFC 0%, #EEF6FA 46%, #F7F4EF 100%)
  *
    box-sizing border-box

.home-dashboard-inner
  position relative
  width 100%
  height 100%
  min-width 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden
  border 1px solid rgba(255, 255, 255, .76)
  border-radius 10px
  background linear-gradient(135deg, rgba(255, 255, 255, .88), rgba(243, 248, 251, .76))
  box-shadow 0 24px 44px rgba(34, 50, 61, .12)
  backdrop-filter blur(28px) saturate(1.08)
  &::before
    content ''
    position absolute
    left 42px
    right 18%
    top 22px
    height 150px
    border-radius 999px
    background linear-gradient(90deg, rgba(255, 255, 255, .74), rgba(255, 255, 255, .16))
    filter blur(2px)
    transform rotate(-4deg)
    pointer-events none

.home-header
  position relative
  z-index 1
  flex 0 0 auto
  min-height 64px
  display flex
  align-items center
  justify-content space-between
  gap 18px
  margin 18px 18px 16px
  padding 0 18px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .86), rgba(247, 251, 253, .74))
  box-shadow 0 10px 24px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter blur(22px) saturate(1.08)
  h1
    margin 0
    color #13242F
    font-size 19px
    line-height 1.2
    font-weight 800
  p
    margin 5px 0 0
    color #71808B
    font-size 13px

.home-header-actions
  display flex
  align-items center
  justify-content flex-end
  gap 8px
  .ant-btn
    height 30px
    padding 0 14px
    border-radius 8px !important
    font-size 12px
    font-weight 800
    box-shadow 0 4px 10px rgba(64, 81, 93, .08)
  .ant-btn-primary
    border-color #0A84FF !important
    background #0A84FF !important

.home-summary-grid
  position relative
  z-index 1
  flex 0 0 auto
  display grid
  grid-template-columns repeat(4, minmax(138px, 1fr))
  gap 16px
  margin 0 18px 16px

.home-summary-card
  position relative
  height 112px
  min-width 0
  padding 18px
  overflow hidden
  border 1px solid rgba(218, 230, 238, .82)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .92), rgba(246, 251, 253, .78))
  box-shadow 0 12px 26px rgba(64, 81, 93, .09), inset 0 1px 0 rgba(255, 255, 255, .96)
  backdrop-filter blur(22px) saturate(1.1)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease
  &::before
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 3px
    background linear-gradient(90deg, #26A8D6, #31C176)
    opacity .9
  &:hover
    transform translateY(-2px)
    border-color rgba(159, 204, 235, .85)
    box-shadow 0 18px 34px rgba(64, 81, 93, .12), inset 0 1px 0 rgba(255, 255, 255, .96)
  small
    position absolute
    left 18px
    bottom 14px
    max-width calc(100% - 100px)
    overflow hidden
    color #8A98A3
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  &.purple
    &::before
      background linear-gradient(90deg, #6B76E8, #2FA8D6)
    .home-summary-icon
      color #6B76E8
  &.warn
    &::before
      background linear-gradient(90deg, #F2B34A, #E25E54)
    .home-summary-icon
      color #D38422
  &.health
    .home-summary-icon
      color #21A66A

.home-summary-meta
  position relative
  z-index 1
  display flex
  flex-direction column
  gap 7px
  span
    color #71808B
    font-size 13px
  b
    color #13242F
    font-size 26px
    line-height 1
    font-weight 800

.home-summary-icon
  position absolute
  top 16px
  right 16px
  width 34px
  height 34px
  display grid
  place-items center
  border-radius 8px
  background rgba(235, 246, 255, .82)
  color #2D88C7
  font-size 19px

.home-donut
  --percent 80
  position absolute
  right 18px
  bottom 16px
  width 54px
  height 54px
  display grid
  place-items center
  border-radius 50%
  background conic-gradient(#31C176 calc(var(--percent) * 1%), #E5EEF4 0)
  box-shadow inset 0 0 0 1px rgba(255, 255, 255, .72), 0 8px 18px rgba(49, 193, 118, .12)
  &::after
    content ''
    position absolute
    inset 7px
    border-radius 50%
    background rgba(255, 255, 255, .94)
  span
    position relative
    z-index 1
    color #21A66A
    font-size 12px
    font-weight 800

.home-mini-chart
  position absolute
  right 13px
  bottom 30px
  width 118px
  height 44px
  opacity .96
  polyline
    fill none
    stroke #31C176
    stroke-width 4
    stroke-linecap round
    stroke-linejoin round
  &.purple polyline
    stroke #2FA8D6

.home-risk-bars
  position absolute
  right 15px
  bottom 42px
  display flex
  align-items center
  gap 6px
  span
    height 8px
    border-radius 4px
    &:nth-child(1)
      width 20px
      background #31C176
    &:nth-child(2)
      width 28px
      background #2FA8D6
    &:nth-child(3)
      width 18px
      background #F2B34A
    &:nth-child(4)
      width 16px
      background #E25E54

.home-toolbar
  position relative
  z-index 1
  flex 0 0 auto
  height 46px
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 0 18px 16px
  padding 8px 12px
  border 1px solid rgba(218, 230, 238, .84)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .84), rgba(247, 251, 253, .74))
  box-shadow 0 10px 22px rgba(64, 81, 93, .08), inset 0 1px 0 rgba(255, 255, 255, .9)
  backdrop-filter blur(22px) saturate(1.08)

.home-group-tabs
  min-width 0
  display flex
  align-items center
  gap 10px
  overflow hidden
  button
    flex 0 0 auto
    height 26px
    padding 0 18px
    border 0
    border-radius 8px
    background rgba(239, 246, 251, .92)
    color #71808B
    cursor pointer
    font-size 12px
    font-weight 800
    white-space nowrap
    &.active
      color #FFFFFF
      background #0A84FF
      box-shadow 0 6px 14px rgba(10, 132, 255, .18)
    &:hover:not(.active)
      color #36505D
      background #E8F2FA

.home-search
  width 220px
  flex 0 0 220px
  .ant-input-affix-wrapper
    height 28px
    border-color #DCE8F0 !important
    background #F8FBFD !important
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-body-grid
  position relative
  z-index 1
  flex 1 1 auto
  min-height 0
  display grid
  grid-template-columns minmax(0, 1fr) 280px
  gap 16px
  margin 0 18px 18px
  overflow hidden

.home-groups
  min-width 0
  min-height 0
  overflow auto
  padding 2px 6px 8px 0
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-group
  margin-bottom 18px

.home-group-head
  display flex
  align-items baseline
  gap 12px
  margin 0 0 12px
  h2
    margin 0
    color #10222D
    font-size 17px
    font-weight 800
  span
    color #71808B
    font-size 13px

.home-server-grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(320px, 1fr))
  gap 16px

.home-server-card
  position relative
  min-width 0
  min-height 214px
  padding 17px 17px 58px
  overflow hidden
  cursor pointer
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .94), rgba(247, 251, 253, .82))
  box-shadow 0 12px 26px rgba(64, 81, 93, .09), inset 0 1px 0 rgba(255, 255, 255, .96)
  backdrop-filter blur(22px) saturate(1.1)
  transition transform .16s ease, box-shadow .16s ease, border-color .16s ease
  &::before
    content ''
    position absolute
    left 0
    right 0
    top 0
    height 3px
    background linear-gradient(90deg, #26A8D6, #31C176)
  &::after
    content ''
    position absolute
    right -34px
    top -42px
    width 120px
    height 120px
    border-radius 50%
    background radial-gradient(circle, rgba(38, 168, 214, .12), rgba(38, 168, 214, 0) 68%)
    pointer-events none
  &.is-warn
    &::before
      background linear-gradient(90deg, #F2B34A, #E25E54)
    &::after
      background radial-gradient(circle, rgba(242, 179, 74, .16), rgba(242, 179, 74, 0) 68%)
  &.is-offline
    opacity .78
    &::before
      background #B7C4CC
    &::after
      background radial-gradient(circle, rgba(126, 142, 153, .12), rgba(126, 142, 153, 0) 68%)
  &:hover
    transform translateY(-2px)
    border-color rgba(159, 204, 235, .86)
    box-shadow 0 18px 34px rgba(64, 81, 93, .13), inset 0 1px 0 rgba(255, 255, 255, .96)

.home-server-card-top
  position relative
  z-index 1
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px
  margin-bottom 12px

.home-server-title-wrap
  min-width 0
  flex 1 1 auto
  display flex
  align-items flex-start
  gap 9px

.home-status-dot
  flex 0 0 auto
  width 10px
  height 10px
  margin-top 6px
  border-radius 50%
  box-shadow 0 0 0 4px rgba(49, 193, 118, .12)
  &.online
    background #31C176
  &.warn
    background #D38422
    box-shadow 0 0 0 4px rgba(211, 132, 34, .13)
  &.offline
    background #E25E54
    box-shadow 0 0 0 4px rgba(226, 94, 84, .12)

.home-server-title
  max-width 100%
  overflow hidden
  color #13242F
  font-size 15px
  font-weight 800
  text-overflow ellipsis
  white-space nowrap

.home-server-sub
  margin-top 2px
  max-width 100%
  overflow hidden
  color #8A98A3
  font-size 12px
  text-overflow ellipsis
  white-space nowrap

.home-server-status
  flex 0 0 auto
  height 22px
  line-height 22px
  padding 0 9px
  border-radius 7px
  font-size 11px
  font-weight 800
  &.online
    color #21A66A
    background rgba(234, 248, 240, .92)
  &.warn
    color #D38422
    background rgba(255, 243, 225, .94)
  &.offline
    color #E25E54
    background rgba(253, 236, 233, .94)

.home-server-host-row
  position relative
  z-index 1
  display flex
  align-items center
  gap 7px
  min-width 0
  height 34px
  margin 0 42px 15px 0
  padding 0 6px 0 11px
  border 1px solid rgba(220, 232, 240, .82)
  border-radius 8px
  background rgba(247, 251, 253, .84)
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .86)

.home-server-host
  flex 1 1 auto
  min-width 0
  overflow hidden
  color #36505D
  font-family 'SF Mono', Menlo, Consolas, monospace
  font-size 13px
  font-weight 700
  text-overflow ellipsis
  white-space nowrap

.home-copy-btn
  flex 0 0 auto
  display inline-flex
  align-items center
  justify-content center
  width 24px
  height 24px
  border 0
  border-radius 7px
  background #EEF6FB
  color #526471
  cursor pointer
  &:hover
    color #13242F
    background #E2F0FA

.home-resource-strip
  position relative
  z-index 1
  display flex
  flex-direction column
  gap 10px
  padding-right 0

.home-metric-bar
  min-width 0
  padding 8px 10px
  border 1px solid rgba(226, 236, 243, .76)
  border-radius 8px
  background rgba(250, 253, 255, .64)

.home-metric-bar-head
  display flex
  align-items center
  justify-content space-between
  gap 6px
  margin-bottom 6px
  span
    color #71808B
    font-size 12px
    font-weight 700
  b
    color #13242F
    font-size 12px
    font-weight 800

.home-strip-track
  width 100%
  height 7px
  overflow hidden
  border-radius 4px
  background #E8F0F5

.home-strip-fill
  height 100%
  border-radius 4px
  background linear-gradient(90deg, #26A8D6, #31C176)
  &.purple
    background linear-gradient(90deg, #6B76E8, #2FA8D6)
  &.blue
    background #2FA8D6
  &.warn
    background linear-gradient(90deg, #F2B34A, #E25E54)

.home-offline-panel
  position relative
  z-index 1
  display flex
  align-items center
  min-height 42px
  color #8A98A3
  font-size 12px

.home-connect-btn
  position absolute
  right 16px
  bottom 16px
  width 32px
  min-width 32px
  height 30px
  padding 0 !important
  border-radius 8px !important
  border-color #0A84FF !important
  background #0A84FF !important
  color #FFFFFF !important
  box-shadow 0 10px 18px rgba(10, 132, 255, .22)
  &:hover
    border-color #0076E8 !important
    background #0076E8 !important
  span:not(.anticon)
    display none

.home-health-panel
  min-width 0
  min-height 0
  display flex
  flex-direction column
  gap 14px
  overflow auto
  padding 2px 2px 8px
  scrollbar-width thin
  scrollbar-color rgba(113, 128, 139, .18) transparent
  &::-webkit-scrollbar
    width 6px
  &::-webkit-scrollbar-thumb
    background rgba(113, 128, 139, .18)
    border-radius 6px

.home-health-card
  position relative
  min-height 0
  padding 16px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .78))
  box-shadow 0 12px 26px rgba(64, 81, 93, .09), inset 0 1px 0 rgba(255, 255, 255, .94)
  backdrop-filter blur(22px) saturate(1.1)
  &.primary
    min-height 96px
    display flex
    align-items center
    justify-content space-between
    span
      display block
      color #71808B
      font-size 13px
    b
      display block
      margin-top 8px
      color #13242F
      font-size 30px
      line-height 1

.home-health-ring
  width 56px
  height 56px
  display grid
  place-items center
  border-radius 50%
  background conic-gradient(#31C176 82%, #E5EEF4 0)
  box-shadow 0 10px 18px rgba(49, 193, 118, .12)
  i
    width 40px
    height 40px
    border-radius 50%
    background rgba(255, 255, 255, .95)

.home-health-title
  display flex
  align-items baseline
  justify-content space-between
  gap 12px
  margin-bottom 14px
  b
    color #13242F
    font-size 14px
  span
    color #8A98A3
    font-size 12px

.home-group-status-list
.home-risk-list
.home-busy-list
  display flex
  flex-direction column
  gap 12px

.home-group-status
.home-busy-item
  display grid
  grid-template-columns minmax(0, 1fr) 74px 34px
  align-items center
  gap 8px
  padding 8px
  border-radius 8px
  background rgba(248, 251, 253, .72)
  span
    overflow hidden
    color #36505D
    font-size 12px
    font-weight 700
    text-overflow ellipsis
    white-space nowrap
  i
    height 7px
    overflow hidden
    border-radius 4px
    background #E8EEF3
  em
    display block
    height 100%
    border-radius 4px
    background linear-gradient(90deg, #26A8D6, #31C176)
  b
    color #13242F
    font-size 12px
    text-align right

.home-risk-item
  display flex
  align-items flex-start
  gap 10px
  padding 8px
  border-radius 8px
  background rgba(255, 248, 238, .7)
  svg
    margin-top 2px
    color #D38422
  div
    min-width 0
  b
    display block
    overflow hidden
    color #13242F
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  span
    display block
    margin-top 3px
    color #8A98A3
    font-size 12px

.home-panel-empty
  color #8A98A3
  font-size 12px

.home-empty
  flex 1 1 auto
  min-height 0
  display flex
  flex-direction column
  align-items center
  justify-content center
  margin 0 18px 18px
  border 1px dashed #CDD9E2
  border-radius 8px
  background linear-gradient(160deg, rgba(255, 255, 255, .86), rgba(247, 251, 253, .74))
  color #657582
  text-align center
  backdrop-filter blur(18px)
  svg
    color #2FA8D6
    font-size 42px
  h2
    margin 18px 0 6px
    color #13242F
  p
    margin 0 0 18px

@media (max-width 1180px)
  .home-body-grid
    grid-template-columns 1fr
  .home-health-panel
    display none

@media (max-width 860px)
  .home-summary-grid
    grid-template-columns repeat(2, minmax(150px, 1fr))
  .home-header
    min-height auto
    align-items flex-start
    flex-direction column
    padding 14px
  .home-toolbar
    height auto
    align-items flex-start
    flex-direction column
  .home-search
    width 100%
    flex auto
  .home-server-grid
    grid-template-columns 1fr
  .home-resource-strip
    grid-template-columns 1fr

@media (max-width 520px)
  .home-dashboard
    left 0
    padding 12px
  .home-summary-grid
    grid-template-columns 1fr
  .home-server-grid
    grid-template-columns minmax(0, 1fr)
  .home-server-card
    min-height 208px
  .home-header-actions
    width 100%
    justify-content flex-start
    flex-wrap wrap
