    overflow hidden
    color var(--ios-shell-dark)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  span
    display block
    margin-top 3px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  strong
    display block
    color var(--ios-shell-dark)
    font-size 12px
    text-align right
  em
    display block
    margin-top 3px
    overflow hidden
    color var(--ios-muted)
    font-size 11px
    font-style normal
    text-align right
    text-overflow ellipsis
    white-space nowrap
  .home-resource-bar-chart
    grid-column 1 / -1

.home-resource-bar-chart
  position relative
  height 10px
  overflow hidden
  border-radius 999px
  background rgba(224, 236, 244, .92)
  i
    position absolute
    left 0
    top 0
    bottom 0
    min-width 4px
    border-radius inherit
    background var(--ios-green)
  .blue &
    i
      background var(--ios-blue)
  .warn &
    i
      background var(--ios-warn)
  .danger &
    i
      background var(--ios-red)

.home-resource-network-row
  display grid
  grid-template-columns minmax(0, 128px) minmax(0, 1fr)
  gap 10px
  align-items center
  padding 9px
  border-radius 8px
  background rgba(248, 251, 253, .72)
  & + &
    margin-top 8px
  div
    min-width 0
  b
    display block
    overflow hidden
    color var(--ios-shell-dark)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  span
    display block
    margin-top 3px
    overflow hidden
    color var(--ios-muted)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap
  strong
    display block
    color #36505D
    font-size 12px
    font-weight 800
    text-align right
    white-space nowrap

.home-resource-network-chart
  display flex
  flex-direction column
  gap 6px
  min-width 0
  > div
    position relative
    display grid
    grid-template-columns 16px minmax(0, 1fr) 86px
    align-items center
    gap 7px
    min-width 0
  span
    margin 0
    color var(--ios-muted)
    font-size 11px
    font-weight 800
  i
    position relative
    height 8px
    min-width 3px
    overflow hidden
    border-radius 999px
    background var(--ios-blue)
    &.up
      background var(--ios-purple)
    &.down
      background var(--ios-blue)

.home-resource-process-table
  overflow hidden
  border 1px solid rgba(226, 236, 243, .76)
  border-radius 8px

.home-resource-process-head
.home-resource-process-row
  display grid
  grid-template-columns 74px 96px 68px 78px minmax(0, 1fr)
  gap 8px
  align-items center
  min-width 0
  padding 8px 10px
