.remote-float-control
  position fixed
  top 10px
  right 10px
  z-index 9999

.remote-float-control-inline
  display inline-block
  position relative

.remote-float-btn-inline
  display inline
  cursor pointer

.remote-float-btn
  padding 8px
  background linear-gradient(180deg, rgba(48, 68, 80, .86), rgba(28, 45, 56, .78))
  backdrop-filter blur(18px) saturate(1.04)
  border 1px solid rgba(169, 204, 224, .18)
  border-radius 8px
  color #F4FAFC
  cursor pointer
  opacity .92
  box-shadow 0 8px 18px rgba(10, 20, 27, .16), inset 0 1px 0 rgba(255, 255, 255, .08)
  transition opacity .2s ease, transform .2s ease, background .2s ease
  display flex
  align-items center
  justify-content center
  &:hover
  &.ant-dropdown-open
    opacity 1
    transform translateY(-1px)
    background linear-gradient(180deg, rgba(60, 82, 94, .9), rgba(35, 56, 68, .84))
