.message-container
  position fixed
  top 20px
  left 50%
  transform translateX(-50%)
  z-index 10000
  pointer-events none

.message-item
  pointer-events all
  margin-bottom 16px
  padding 8px 16px
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .84))
  color var(--ios-text)
  border 1px solid rgba(218, 230, 238, .86)
  box-shadow 0 12px 24px rgba(64, 81, 93, .1), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter blur(20px) saturate(1.06)
  display flex
  align-items center
  animation message-fade-in 0.3s ease
  position relative
  justify-content center
  &:hover
    .message-close
      opacity 1

.message-content-wrap
  display flex
  align-items center

.msg-icon
  margin-right 8px
  font-size 16px
  &.info
    color var(--info)
  &.success
    color var(--success)
  &.warning
    color var(--warn)
  &.error
    color var(--error)

.message-close
  margin-left 8px
  cursor pointer
  font-size 12px
  color var(--ios-muted)
  &:hover
    color var(--ios-shell-dark)
    font-weight bold

@keyframes message-fade-in
  from
    opacity 0
    transform translateY(-20px)
  to
    opacity 1
    transform translateY(0)
