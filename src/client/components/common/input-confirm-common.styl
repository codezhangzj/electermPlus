.input-confirm
  width 100%
  display flex
  gap 8px
  padding 8px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background rgba(255, 255, 255, .82)
  box-shadow inset 0 1px 0 rgba(255, 255, 255, .9)
  .ant-input-number
    flex 1
  .ant-input
  .ant-input-number
  .ant-input-number-input
  .ant-input-affix-wrapper
    border-radius 8px

.app-theme-defaultDark
  .input-confirm
    background rgba(255, 255, 255, .06)
    border-color rgba(169, 204, 224, .16)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .06)
    .ant-input
    .ant-input-number
    .ant-input-affix-wrapper
      color #DDEBF0
      background rgba(18, 35, 46, .86) !important
      border-color rgba(124, 212, 255, .18) !important
    .ant-input-number-input
      color #DDEBF0
      background transparent
    .ant-input::placeholder
    .ant-input-number-input::placeholder
      color rgba(214, 227, 234, .46)

.app-theme-defaultGlass
  .input-confirm
    background rgba(255, 255, 255, .54)
    border-color rgba(255, 255, 255, .72)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .7)
