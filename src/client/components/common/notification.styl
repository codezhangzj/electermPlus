.notification-container
  position fixed
  bottom 20px
  right 20px
  z-index 9999

.notification
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .84))
  color var(--ios-text)
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  margin-bottom 10px
  padding 12px 16px
  box-shadow 0 16px 30px rgba(64, 81, 93, .13), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter blur(22px) saturate(1.06)
  width 400px
  position relative

.notification-content
  width 100%

.notification-message
  font-weight bold

.notification-title
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  padding 0 30px 0 20px

.notification-icon
  font-size 16px
  position absolute
  left 12px
  top 10px

.notification-description
  word-wrap break-word
  max-height 200px
  overflow auto
  padding 10px 0 0 0

.notification-close
  position absolute
  top 12px
  right 12px
  background none
  border none
  color var(--ios-muted)
  font-size 18px
  cursor pointer
  padding 0
  &:hover
    color var(--ios-shell-dark)

.notification-copy-icon
  cursor pointer
  font-size 14px
  position absolute
  right 10px
  top 45px
  margin-left 8px
  display none
.notification-message .notification-copy-icon
  right 38px
  top 14px
.notification-message:hover .notification-copy-icon,
.notification-description:hover .notification-copy-icon
  display inline-block
