.custom-modal-wrap
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  overflow auto
  outline 0

.custom-modal-mask
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  background rgba(16, 34, 45, .26)
  backdrop-filter var(--glass-scrim)

.custom-modal-container
  position relative
  display flex
  align-items flex-start
  justify-content center
  min-height 100%
  padding 24px
  word-break break-word

.custom-modal-content
  position relative
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .84))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 18px 34px rgba(64, 81, 93, .14), inset 0 1px 0 rgba(255, 255, 255, .92)
  backdrop-filter var(--glass)
  margin-top 50px
  max-width calc(100vw - 48px)

.custom-modal-header
  display flex
  align-items center
  justify-content space-between
  padding 16px 24px
  border-bottom 1px solid rgba(218, 230, 238, .86)

.custom-modal-title
  font-size 16px
  font-weight 600
  color var(--ios-shell-dark)
  line-height 1.5
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.custom-modal-close
  display flex
  align-items center
  justify-content center
  width 32px
  height 32px
  padding 0
  margin-left 8px
  background transparent
  border none
  border-radius 8px
  color var(--ios-muted)
  cursor pointer
  transition background-color 0.2s
  &:hover
    color var(--ios-shell-dark)
    background rgba(236, 246, 253, .78)
  &:focus
    outline none

.custom-modal-body
  padding 0 24px 24px 24px
  color var(--ios-text)

.custom-modal-footer
  padding 12px 24px
  border-top 1px solid rgba(218, 230, 238, .86)
  text-align right

.custom-modal-footer-buttons
  display flex
  justify-content flex-end
  gap 8px

.custom-modal-ok-btn,
.custom-modal-cancel-btn
  padding 6px 16px
  border none
  border-radius 8px
  cursor pointer
  font-size 14px
  transition background-color 0.2s

.custom-modal-ok-btn
  background var(--primary)
  color var(--primary-contrast)

.custom-modal-cancel-btn
  background rgba(241, 246, 250, .9)
  color var(--ios-text)

.app-theme-defaultDark
  .custom-modal-mask
    background rgba(8, 17, 23, .42)
  .custom-modal-content
    color #DDEBF0
    background linear-gradient(180deg, rgba(43, 63, 76, .92), rgba(25, 41, 51, .84))
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 14px 28px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(255, 255, 255, .07)
  .custom-modal-header
  .custom-modal-footer
    border-color rgba(169, 204, 224, .14)
  .custom-modal-title
    color #F4FAFC
  .custom-modal-body
    color #DDEBF0
  .custom-modal-close
    color #D6E3EA
    &:hover
      color #FFFFFF
      background rgba(255, 255, 255, .1)
  .custom-modal-cancel-btn
    color #D6E3EA
    background rgba(255, 255, 255, .08)

.app-theme-defaultGlass
  .custom-modal-content
    background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58))
    border-color rgba(255, 255, 255, .74)
    box-shadow 0 12px 24px rgba(49, 66, 77, .09), inset 0 1px 0 rgba(255, 255, 255, .7)
  .custom-modal-header
  .custom-modal-footer
    border-color rgba(255, 255, 255, .74)
