.context-menu
  position: relative
  width 280px

.context-item
  -webkit-app-region no-drag
  position relative
  height 28px
  line-height 28px
  padding 0 16px
  border-radius 8px
  color var(--ios-text)
  &:hover
    background rgba(236, 246, 253, .78)
    color var(--ios-shell-dark)
    cursor pointer
  &.disabled
    color #9AA8B2
    &:hover
      color #9AA8B2
      background rgba(236, 246, 253, .52)
      cursor not-allowed
  &.zoom-item
    height 36px
    line-height 36px
    &:hover
      background transparent

.context-sub-text
  position absolute
  right 16px
  top 0
  color #7A8B96

.context-menu
  hr
    margin 0
    border none
    border-bottom 1px solid var(--ios-border)
.sub-context-menu
  display none
  width 200px
  position absolute
  left 100%
  top 0
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  backdrop-filter var(--glass)
  max-height 300px
  overflow-y scroll
  color var(--ios-text)
.with-sub-menu
  &:hover
    .sub-context-menu
      display block

.sub-context-menu-item
  cursor pointer
  padding 5px 16px
  border-radius 8px
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  &:hover, &.active
    background-color rgba(236, 246, 253, .78)
    color var(--ios-shell-dark)
.bookmarks-sub-context-menu
  width 380px
  padding 20px 10px 10px 20px

.menu-control
  width 28px
  height 28px
  border-radius 8px
  color rgba(255, 255, 255, .72)
  font-size 16px
  text-align center
  display inline-block
  line-height 28px
  cursor pointer
  &:hover
    color #fff
.is-main
  .menu-control
    img
      border 1px solid var(--text-dark)
      border-radius 8px
      background rgba(255, 255, 255, .14)
