.qm-list-wrap
  max-height calc(100vh - 100px)
  overflow-y scroll
  padding 16px 8px 10px 8px
.qm-wrap-tooltip
  background linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(247, 251, 253, .82))
  backdrop-filter var(--glass)
  position absolute
  left 72px
  right 0
  z-index 89
  height auto
  bottom 36px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px 8px 0 0
  box-shadow 0 -14px 28px rgba(64, 81, 93, .1), inset 0 1px 0 rgba(255, 255, 255, .9)

.qm-pinned
  .qm-wrap-tooltip
    height 180px
  .qm-list-wrap
    max-height 100px

.qm-search-input
  max-width 200px
@media (max-width: 500px)
  .qm-search-input
    width 100px

.item-list-unit.dragover
  border 1px dashed var(--primary)
  background rgba(236, 246, 253, .78)
.qm-item-dragover
  border-left 2px solid var(--primary)
.qm-field-dragging
  opacity 0.4
.qm-field-dragover
  border-top 2px solid var(--primary)
.qm-label-select
  min-width 120px

.qm-flex
  gap 8px
  align-items center

@media (max-width: 768px)
  .qm-flex
    flex-direction column
    align-items flex-start
  .qm-search-input
    max-width none
    width 100%
  .qm-label-select
    width 100%
