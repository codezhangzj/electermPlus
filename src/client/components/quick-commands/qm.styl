.qm-list-wrap
  max-height calc(100vh - 100px)
  overflow-y scroll
  padding 16px 8px 10px 8px
.qm-wrap-tooltip
  background rgba(255, 255, 255, .88)
  backdrop-filter blur(18px)
  position absolute
  left 72px
  right 0
  z-index 89
  height auto
  bottom 36px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius) var(--ios-radius) 0 0
  box-shadow var(--ios-shadow)

.qm-pinned
  .qm-wrap-tooltip
    height 180px
  .qm-list-wrap
    max-height 100px

.qm-search-input
  max-width 200px
@media (max-width: 500px)
  .qm-search-input
    width 100px

.item-list-unit.dragover
  border 1px dashed var(--primary)
  background rgba(47, 168, 214, .08)
.qm-item-dragover
  border-left 2px solid var(--primary)
.qm-field-dragging
  opacity 0.4
.qm-field-dragover
  border-top 2px solid var(--primary)
.qm-label-select
  min-width 120px

.qm-flex
  gap 8px
  align-items center

@media (max-width: 768px)
  .qm-flex
    flex-direction column
    align-items flex-start
  .qm-search-input
    max-width none
    width 100%
  .qm-label-select
    width 100%
