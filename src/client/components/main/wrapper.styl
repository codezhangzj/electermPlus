
.error-wrapper
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 52%, #F7F4F0 100%)
  height 100%
  position fixed
  overflow-y scroll
  color var(--ios-text)

#container
  .xterm
    padding 10px
  .session-batch-active
    .xterm-screen
      &::before
        font-size 30vmin
        font-weight bold
        color rgba(93, 112, 124, .16)
        display flex
        justify-content center
        align-items center
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        z-index -1
