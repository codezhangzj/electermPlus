
.error-wrapper
  background linear-gradient(135deg, #F7FAFC 0%, #EEF4F7 52%, #F7F3EF 100%)
  height 100%
  position fixed
  overflow-y scroll
  color #172B36

#container
  .xterm
    padding 10px
  .session-batch-active
    .xterm-screen
      &::before
        font-size 30vmin
        font-weight bold
        color rgba(19, 36, 47, .18)
        display flex
        justify-content center
        align-items center
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        z-index -1
