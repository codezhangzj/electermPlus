.upgrade-panel
  position fixed
  right 14px
  bottom 14px
  z-index 888
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  backdrop-filter blur(22px) saturate(1.06)
  border-radius 8px
  border 1px solid rgba(218, 230, 238, .86)
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  padding 0
  width 440px
.upgrade-panel-hide
  left -600px
  top 400px
  right auto
  bottom auto
.close-upgrade-panel
  &:hover
    color var(--success)
.upgrade-panel-title
.upgrade-panel-body
  padding 12px 15px
.upgrade-panel-title
  border-bottom 1px solid rgba(218, 230, 238, .86)
  font-weight 800
  color var(--ios-shell-dark)
.markdown-wrap
  max-height 20vh
  overflow-y auto
