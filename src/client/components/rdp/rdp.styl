.rdp-session-wrap
  display: flex
  flex-direction: column
  justify-content: center
  align-items: center
  background var(--ios-terminal-dark)
  .session-v-info
    position: absolute
    top: 0
    left: 0
    width: 100%
    z-index: 300
  &.scale-viewport
    .rdp-scroll-wrapper canvas
      width: 100% !important
      height: 100% !important
      object-fit: contain

.s-scroll-wrapper
  &::-webkit-scrollbar
    width 12px
    height 12px
    background transparent
  &::-webkit-scrollbar-track
    background transparent
    box-shadow none
  &::-webkit-scrollbar-thumb
    background rgba(124, 148, 160, .38)
    border-radius 8px
    border 3px solid transparent
    background-clip content-box
  &::-webkit-scrollbar-corner
    background transparent
.rdp-scroll-wrapper
  position relative
  background var(--ios-terminal-dark)
  z-index 299

.rdp-file-transfer-btn
  font-size: 16px
  color: #DDEBF0
  padding 6px
  border-radius 8px
  transition: color 0.2s, background .2s
  &:hover
    color: #7CD4FF
    background rgba(255, 255, 255, .10)

.rdp-download-disabled
  opacity: 0.4
  cursor: not-allowed
  &:hover
    color: #DDEBF0
    background transparent

canvas
  outline: none

@keyframes rdp-download-flash
  0%, 100%
    color: var(--primary)
    transform: scale(1)
  50%
    color: var(--success)
    transform: scale(1.2)

.rdp-download-flash
  animation: rdp-download-flash 1s ease-in-out infinite
