

.close-setting-wrap
  position absolute
  top 70px
  font-size 16px
  cursor pointer
  z-index 889
  right 20px
  width 32px
  height 32px
  display flex
  align-items center
  justify-content center
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .76)
  color #6D7E8A
  border 1px solid var(--ios-border)
  box-shadow 0 6px 12px rgba(49, 66, 77, .08)
  &:hover
    color #13242F
    background rgba(47, 168, 214, .08)
.alt-close-setting-wrap
  left 20px
  right auto
.batch-op-wrap .close-setting-wrap
  top 40px
  right 30px
.setting-row
  position absolute
  top 127px
  overflow-y scroll
.setting-row-left
  left 0
  width 340px
  bottom 0
  padding 20px 10px 20px 20px
  display flex
  flex-direction column
  .model-bookmark-tree-wrap
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
.setting-row-right
  left 340px
  right 0
  bottom 0
  top 129px
  padding 20px
  background var(--ios-surface)
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  box-shadow var(--ios-shadow-soft)
  backdrop-filter blur(18px)
.setting-tabs-bookmarks
  .setting-row-left
    width 440px
  .setting-row-right
    left 483px
.setting-tabs
  position absolute
  z-index 4
  left 0
  top 0
  right 0
  padding 55px 20px 0 50px
  background linear-gradient(135deg, rgba(247, 250, 252, .82), rgba(238, 244, 247, .62))
.setting-col
  ::-webkit-scrollbar
    width 0
@media (max-width: 1100px)
  .setting-col
    position fixed
    top 128px
    bottom 0
    left 72px
    right 0
    overflow-y scroll
  .setting-row
    position static
    top auto
  .setting-row-left
    left auto
    width auto
    bottom auto
    padding 138px 10px 10px 10px
  .setting-row-right
    left auto
    right auto
    bottom auto
    top auto
    padding 10px
  .setting-tabs-bookmarks
    .setting-row-left
      width auto
    .setting-row-right
      left auto
