
.item-list-wrap
  overflow-y scroll
  &::-webkit-scrollbar
    width 0
.list-item-edit
.list-item-apply
.list-item-remove
.list-item-bookmark
.list-item-duplicate
.list-item-autorun
  display none
  width 24px
  line-height 35px
  text-align center
  position absolute
  right 0
  top 0
.list-item-autorun
  right 24px

.list-item-title
  flex-grow: 1
.item-list-unit
  display flex
  position relative
  margin-bottom 6px
  padding 6px 10px
  border-radius var(--ios-radius)
  cursor pointer
  line-height 1.8
  color #172B36
  &.active
    background #13242F
    color #fff
    box-shadow 0 8px 16px rgba(19, 36, 47, .14)
  &.current
    font-weight bold
  &:hover
    background rgba(47, 168, 214, .08)
    color #13242F
    .list-item-apply
    .list-item-edit
    .list-item-remove
    .list-item-bookmark
    .list-item-duplicate
    .list-item-autorun
      display block
.theme-item:hover
    .list-item-remove
      right 24px
.setting-tabs-setting
  .item-list-unit
    .list-item-remove
      display none
