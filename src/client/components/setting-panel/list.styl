
.item-list-wrap
  overflow-y scroll
  &::-webkit-scrollbar
    width 0
.list-item-edit
.list-item-apply
.list-item-remove
.list-item-bookmark
.list-item-duplicate
.list-item-autorun
  display none
  width 24px
  line-height 35px
  text-align center
  position absolute
  right 0
  top 0
.list-item-autorun
  right 24px

.list-item-title
  flex-grow: 1
.item-list-unit
  display flex
  position relative
  margin-bottom 6px
  padding 6px 10px
  border 1px solid transparent
  border-radius 8px
  cursor pointer
  line-height 1.8
  color var(--ios-text)
  transition background .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease
  &.active
    background linear-gradient(180deg, rgba(237, 247, 255, .96), rgba(221, 240, 255, .86))
    border-color rgba(136, 194, 255, .45)
    color #0A5FB8
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .9), 0 6px 14px rgba(10, 132, 255, .11)
  &.current
    font-weight bold
  &:hover
    background rgba(236, 246, 253, .78)
    border-color rgba(218, 230, 238, .86)
    color var(--ios-shell-dark)
    .list-item-apply
    .list-item-edit
    .list-item-remove
    .list-item-bookmark
    .list-item-duplicate
    .list-item-autorun
      display block
.theme-item:hover
    .list-item-remove
      right 24px
.setting-tabs-setting
  .item-list-unit
    .list-item-remove
      display none
// .item-list
//   .list-item-edit
//   .list-item-apply
//     right 20px
.item-list-unit
  .list-item-bookmark
    right 18px
  .list-item-duplicate
    right 24px

.app-theme-defaultDark
  .item-list-unit
    color #D6E3EA
    border-color transparent
    &.active
      color #DDF3FF
      background linear-gradient(180deg, rgba(82, 142, 181, .34), rgba(47, 91, 118, .26))
      border-color rgba(124, 212, 255, .22)
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .08), 0 6px 14px rgba(0, 0, 0, .14)
    &:hover
      color #FFFFFF
      background rgba(255, 255, 255, .08)
      border-color rgba(169, 204, 224, .14)

.app-theme-defaultGlass
  .item-list-unit
    &.active
      background linear-gradient(180deg, rgba(237, 247, 255, .88), rgba(221, 240, 255, .68))
