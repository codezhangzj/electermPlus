
.theme-item
  border 1px solid transparent
  border-radius 8px
  background rgba(255, 255, 255, .58)
  margin-bottom 8px
  transition background .16s ease, border-color .16s ease, box-shadow .16s ease
  &:hover
    border-color rgba(218, 230, 238, .86)
    background rgba(255, 255, 255, .88)
    box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)

.theme-item.current
  border-color rgba(49, 193, 118, .42)
  box-shadow inset 3px 0 0 var(--ios-green), 0 8px 18px rgba(49, 66, 77, .07)
