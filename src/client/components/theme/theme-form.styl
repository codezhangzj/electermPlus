.theme-editor-txt
  padding 12px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .76)
  box-shadow var(--ios-shadow-soft)
  .editor-u-textarea
    display block !important
  .editor-u-picker
    display none !important
.theme-editor-color-picker
  padding 12px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .76)
  box-shadow var(--ios-shadow-soft)
  .editor-u-textarea
    display none !important
  .editor-u-picker
    display block !important
