
.term-search-opt-icon
  margin 0 3px
  padding 4px
  color #6D7E8A
  font-size 15px
  border-radius 7px
  transition color .16s ease, background .16s ease
  &:hover
    color var(--ios-shell-dark)
    background rgba(236, 246, 253, .78)
  &.term-search-on
    background linear-gradient(180deg, rgba(237, 247, 255, .96), rgba(221, 240, 255, .86))
    color #0A5FB8
    box-shadow inset 0 0 0 1px rgba(136, 194, 255, .45)
.term-search-wrap
  position absolute
  top 64px
  right 12px
  z-index 200
  padding 8px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  backdrop-filter var(--glass)
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
