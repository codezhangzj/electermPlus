
.term-search-opt-icon
  margin 0 3px
  padding 4px
  color #6D7E8A
  font-size 15px
  border-radius 7px
  transition color .16s ease, background .16s ease
  &:hover
    color #13242F
    background rgba(19, 36, 47, .07)
  &.term-search-on
    background #13242F
    color #FFFFFF
.term-search-wrap
  position absolute
  top 100px
  right 12px
  z-index 200
  padding 8px
  border 1px solid var(--ios-border)
  border-radius var(--ios-radius)
  background rgba(255, 255, 255, .90)
  backdrop-filter blur(18px)
  box-shadow var(--ios-shadow)
