
.terms-box
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 100%)
  position relative
.loading-wrapper
  padding 30px
  z-index 100
.term-search-box
  position absolute
  right 5px
  top 5px
  z-index 30

.terminal-control
  position relative
  z-index 40
  height 32px
  background transparent
  border-bottom 0
  line-height 32px
  padding 0 16px
  color #5D707C
  box-sizing border-box
  flex-shrink 0

.terms-box
  position relative
.term-wrap
  background linear-gradient(135deg, #FFFFFF 0%, #F4F8FA 100%)
  position absolute
  box-sizing border-box
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  overflow hidden
  padding 18px
  *
    box-sizing border-box
  .xterm-screen::before
    background-image none !important
    opacity 0 !important

  &.terminal-theme-defaultDark
    background linear-gradient(135deg, rgba(31, 51, 63, .96), rgba(38, 61, 74, .9))
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 8px 18px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255, 255, 255, .1)
    padding 18px

    .term-wrap-2
      right 18px
      bottom 18px
      background linear-gradient(135deg, rgba(12, 23, 30, .98), rgba(17, 30, 38, .96))
      border-color rgba(169, 204, 224, .14)
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .06)

  &.terminal-theme-defaultGlass
    background linear-gradient(135deg, rgba(223, 234, 240, .96) 0%, rgba(238, 246, 249, .86) 100%)
    border-color rgba(255, 255, 255, .74)
    backdrop-filter var(--glass)
    box-shadow 0 10px 22px rgba(49, 66, 77, .09), inset 0 1px 0 rgba(255, 255, 255, .7)
    padding 22px
    overflow hidden

    &::after
      content ''
      position absolute
      inset 0
      border-radius 8px
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .72), inset 0 -1px 0 rgba(255, 255, 255, .34)
      pointer-events none
      z-index 3

    .term-wrap-2
      left 22px
      right 22px
      top 22px
      bottom 22px
      background linear-gradient(135deg, rgba(255, 255, 255, .78) 0%, rgba(238, 246, 249, .60) 100%)
      border-color rgba(255, 255, 255, .74)
      backdrop-filter var(--glass)
      box-shadow inset 0 1px 0 rgba(255, 255, 255, .68), 0 8px 18px rgba(34, 50, 61, .08)

.term-wrap-2
  z-index 2
  left 18px
  top 18px
  right 18px
  bottom 18px
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  background #FFFFFF
  overflow hidden

@media (max-width 980px)
  .term-wrap
    padding 18px
  .term-wrap-2
    right 18px

.vertical
  .term-wrap.not-first-term
    border-top 1px solid var(--ios-border)
.horizontal
  .term-wrap.not-first-term
    border-left 1px solid var(--ios-border)
.term-sftp-tabs
  margin-left 5px

#container
  .xterm-screen::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background-repeat no-repeat
    background-position center
    background-color transparent !important

.terminal-normal-buffer
  position absolute
  left 0
  top 0
  width 100%
  background rgba(255, 255, 255, .92)
  color var(--ios-text)
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 0 0 8px 8px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  backdrop-filter var(--glass)
  z-index 66
  padding-bottom 32px
.terminal-normal-buffer-body
  overflow-y scroll
  max-height 300px
.terminal-normal-buffer-close
  cursor pointer
  font-size 14px
  color #6D7E8A
  &:hover
    color var(--ios-shell-dark)
.terminal-normal-buffer-footer
  position absolute
  left 0
  top calc(100% - 32px)
  width 100%
  height 32px
  line-height 32px
  box-shadow 0 -8px 18px rgba(49, 66, 77, .10)
  background var(--ios-surface-strong)
.batch-input-wrap
  width calc(100% - 80px)

.terminal-suggestions-wrap
  position absolute
  z-index 100
  max-height 300px
  max-width 300px
  min-width 200px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  display flex
  flex-direction column
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  backdrop-filter var(--glass)
  &.reverse .terminal-suggestions-list
    border-top 1px solid var(--ios-border)
    border-bottom none

.terminal-suggestions-list
  flex 1
  overflow-x hidden
  overflow-y auto
  max-height 268px
  max-width 300px
  border-bottom 1px solid var(--ios-border)

.terminal-suggestions-sticky
  flex-shrink 0
  height 32px
  padding 0 10px
  line-height 32px
  color #6D7E8A
  font-weight 700

.suggestion-item
  display flex
  align-items center
  padding 7px 10px
  cursor pointer
  color var(--ios-text)
  border-radius 8px
  margin 2px 4px
  &:hover
    background-color rgba(47, 168, 214, .08)
    .suggestion-delete
      visibility visible

.suggestion-command
  flex-grow 1
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.suggestion-type
  margin-left 5px
  font-size 0.8em
  color #2FA8D6
  &:hover
    color var(--success)

.suggestion-hint
  margin-left 5px
  font-size 0.8em
  color var(--text-light, #888)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  max-width 150px

.suggestion-delete
  margin-left 5px
  visibility hidden

.term-search-bar
  position absolute
  right 0
  top 0
  bottom 0
  background transparent
  width 16px
.paste-text
  max-height 200px
  overflow-y scroll

.terminal-reconnect-overlay
  position absolute
  right 18px
  bottom 18px
  display flex
  align-items center
  gap 10px
  padding 9px 12px
  border 1px solid rgba(240, 179, 90, .28)
  border-radius 8px
  background rgba(20, 34, 43, .82)
  backdrop-filter var(--glass-sm)
  color #F4FAFC
  font-size 12px
  box-shadow 0 8px 18px rgba(0, 0, 0, .18)
  pointer-events auto
  z-index 110
  b
    font-weight 800
  span
    color rgba(244, 250, 252, .72)
  button
    height 24px
    padding 0 9px
    border 0
    border-radius 6px
    background rgba(255, 255, 255, .12)
    color #F4FAFC
    cursor pointer
    font-size 11px
    &:hover
      background rgba(226, 94, 84, .78)

.terminal-error-handle
  position absolute
  left 0
  top 0
  z-index 100
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82))
  border 1px solid rgba(218, 230, 238, .86)
  border-radius 8px
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  max-width calc(100% - 24px)
  color var(--ios-text)
