@require './includes'
@require './includes/theme'

body
  overflow hidden
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 42%, #F7F4F0 100%)
  font-size 12px
  line-height 1.5715
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'
  font-variant: tabular-nums
  color var(--text)

:root
  --ios-bg #F9FBFC
  --ios-bg-soft #EEF5F8
  --ios-surface rgba(255, 255, 255, .82)
  --ios-surface-strong rgba(255, 255, 255, .94)
  --ios-panel #F7FAFC
  --ios-border #E3EBF0
  --ios-border-soft rgba(255, 255, 255, .74)
  --ios-shadow 0 22px 30px rgba(34, 50, 61, .16)
  --ios-shadow-soft 0 12px 20px rgba(34, 50, 61, .11)
  --ios-radius 8px
  --ios-radius-sm 8px
  --ios-shell-dark #13242F
  --ios-terminal-dark #0F1D25
  --ios-terminal-light #FFFFFF
  --ios-text #10222D
  --ios-muted #748490
  --ios-green #31C176
  --ios-blue #2FA8D6
  --ios-purple #6B76E8
  --ios-warn #F0B35A
  --ios-red #E25E54

#container
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 42%, #F7F4F0 100%)

::-webkit-scrollbar
  background transparent
  width 8px
  height 8px

.term-wrap:hover
  ::-webkit-scrollbar
    width 12px

::-webkit-scrollbar-track
  -webkit-box-shadow none

::-webkit-scrollbar-thumb
  background-color rgba(113, 128, 139, .34)
  outline none
  border-radius 8px
  border 2px solid transparent
  background-clip content-box
  &:hover
    background-color rgba(45, 138, 200, .58)

::-webkit-scrollbar-corner
  background-color transparent

.common-err
  max-height 100px
  overflow-y scroll
  overflow-x hidden
  word-break break-all

a
  color var(--primary)
  &:hover
    color var(--text-light)

.cap
  text-transform capitalize

.ant-btn
  border-radius var(--ios-radius) !important
  box-shadow none
  font-weight 600
  border-color var(--ios-border)
  &.ant-btn-primary
    border-color var(--ios-shell-dark)
    background var(--ios-shell-dark)
    box-shadow 0 8px 16px rgba(19, 36, 47, .16)
    &:hover
      background #223743 !important
      border-color #223743 !important

.ant-input
.ant-input-affix-wrapper
.ant-select-selector
.ant-picker
  border-radius var(--ios-radius) !important
  border-color var(--ios-border) !important
  background rgba(255, 255, 255, .82) !important
  box-shadow none !important

.ant-modal-content
.ant-drawer-content
.ant-popover-inner
.ant-dropdown-menu
  border-radius var(--ios-radius) !important
  border 1px solid var(--ios-border)
  background var(--ios-surface-strong) !important
  box-shadow var(--ios-shadow) !important

.ant-modal-header
  border-radius var(--ios-radius) var(--ios-radius) 0 0 !important
  background transparent !important

.ant-tabs-tab
.ant-segmented
.ant-card
  border-radius var(--ios-radius) !important

.ant-switch
  min-width 36px !important
  height 18px !important
  line-height 18px !important
  border-radius 9px !important
  background #CAD6DE !important
  border none !important
  &.ant-switch-checked
    background #31C176 !important
  .ant-switch-handle
    width 14px !important
    height 14px !important
    top 2px !important
    inset-inline-start 2px !important
  &.ant-switch-checked .ant-switch-handle
    inset-inline-start calc(100% - 16px) !important
  .ant-switch-inner
    display none !important

