@require './includes'
@require './includes/theme'

body
  overflow hidden
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 42%, #F7F4F0 100%)
  font-size 12px
  line-height 1.5715
  font-family Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'
  font-variant: tabular-nums
  color var(--text)

:root
  --ios-bg #F9FBFC
  --ios-bg-soft #EEF5F8
  --ios-surface rgba(255, 255, 255, .82)
  --ios-surface-strong rgba(255, 255, 255, .94)
  --ios-panel rgba(247, 251, 253, .82)
  --ios-border rgba(218, 230, 238, .86)
  --ios-border-soft rgba(255, 255, 255, .74)
  --ios-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9)
  --ios-shadow-soft 0 8px 18px rgba(49, 66, 77, .07)
  --ios-radius 8px
  --ios-radius-sm 8px
  --ios-shell-dark #13242F
  --ios-terminal-dark #0F1D25
  --ios-terminal-light #FFFFFF
  --ios-text #10222D
  --ios-muted #748490
  --ios-green #31C176
  --ios-blue #2FA8D6
  --ios-purple #6B76E8
  --ios-warn #F0B35A
  --ios-red #E25E54
  // glassmorphism tiers — single source of truth for backdrop blur.
  // sm: subtle rows/chips · base: default cards/surfaces ·
  // lg: headers/sidebars/prominent overlays · scrim: modal/drawer masks.
  --glass-sm blur(14px) saturate(1.05)
  --glass blur(22px) saturate(1.06)
  --glass-lg blur(32px) saturate(1.2)
  --glass-scrim blur(8px) saturate(1.02)

// respect the OS accessibility setting "reduce transparency": drop every
// blur tier so glass surfaces render as plain panels — cheaper for the GPU
// (no extra compositing layers over the WebGL terminal) and higher contrast.
@media (prefers-reduced-transparency: reduce)
  :root
    --glass-sm none
    --glass none
    --glass-lg none
    --glass-scrim none

#container
  background linear-gradient(135deg, #F9FBFC 0%, #EEF5F8 42%, #F7F4F0 100%)

body.app-theme-defaultDark
  background linear-gradient(135deg, #152631 0%, #1D3340 54%, #253D4A 100%)

body.app-theme-defaultDark #container
  background linear-gradient(135deg, #152631 0%, #1D3340 54%, #253D4A 100%)

body.app-theme-defaultGlass
  background linear-gradient(135deg, #DFEAF0 0%, #EEF6F9 100%)

body.app-theme-defaultGlass #container
  background linear-gradient(135deg, #DFEAF0 0%, #EEF6F9 100%)

::-webkit-scrollbar
  background transparent
  width 8px
  height 8px

.term-wrap:hover
  ::-webkit-scrollbar
    width 12px

::-webkit-scrollbar-track
  -webkit-box-shadow none

::-webkit-scrollbar-thumb
  background-color rgba(113, 128, 139, .34)
  outline none
  border-radius 8px
  border 2px solid transparent
  background-clip content-box
  &:hover
    background-color rgba(45, 138, 200, .58)

::-webkit-scrollbar-corner
  background-color transparent

.common-err
  max-height 100px
  overflow-y scroll
  overflow-x hidden
  word-break break-all

a
  color var(--primary)
  &:hover
    color var(--text-light)

.cap
  text-transform capitalize

.ant-btn
  border-radius 8px !important
  box-shadow none
  font-weight 600
  border-color var(--ios-border)
  transition all 0.3s ease
  &.ant-btn-primary
    border-color #0A84FF
    background #0A84FF
    box-shadow 0 6px 14px rgba(10, 132, 255, .16)
    &:hover
      background #0A73E8 !important
      border-color #0A73E8 !important

.ant-input
.ant-input-affix-wrapper
.ant-select-selector
.ant-picker
  border-radius 8px !important
  border-color var(--ios-border) !important
  background rgba(255, 255, 255, .82) !important
  box-shadow none !important

.ant-modal-content
.ant-drawer-content
.ant-popover-inner
.ant-dropdown-menu
  border-radius 8px !important
  border 1px solid var(--ios-border)
  background linear-gradient(180deg, rgba(255, 255, 255, .92), rgba(247, 251, 253, .82)) !important
  box-shadow 0 8px 18px rgba(49, 66, 77, .07), inset 0 1px 0 rgba(255, 255, 255, .9) !important
  backdrop-filter var(--glass-lg)

.ant-modal-header
  border-radius 8px 8px 0 0 !important
  background transparent !important

.ant-tabs-tab
.ant-segmented
.ant-card
.ant-alert
  border-radius 8px !important

.ant-table-wrapper
  .ant-table
    background transparent
    color var(--ios-text)
  .ant-table-container
    border-radius 8px
    overflow hidden
  .ant-table-thead > tr > th
    color var(--ios-muted)
    background rgba(247, 250, 252, .9) !important
    border-bottom-color rgba(218, 230, 238, .86) !important
  .ant-table-tbody > tr > td
    color var(--ios-text)
    background rgba(255, 255, 255, .72) !important
    border-bottom-color rgba(218, 230, 238, .72) !important
  .ant-table-tbody > tr:nth-child(even) > td
    background rgba(255, 255, 255, .58) !important
  .ant-table-tbody > tr:hover > td
    background rgba(236, 246, 253, .82) !important

.ant-pagination
  .ant-pagination-item
  .ant-pagination-prev
  .ant-pagination-next
  .ant-pagination-options .ant-select-selector
    border-radius 8px !important

.ant-alert
  border-color rgba(218, 230, 238, .86) !important
  background rgba(236, 246, 253, .78) !important
  color var(--ios-text)

.ant-form-item-label > label
  color var(--ios-text)

.ant-typography
  color inherit

.ant-switch
  min-width 36px !important
  height 18px !important
  line-height 18px !important
  border-radius 9px !important
  background #CAD6DE !important
  border none !important
  &.ant-switch-checked
    background #31C176 !important
  .ant-switch-handle
    width 14px !important
    height 14px !important
    top 2px !important
    inset-inline-start 2px !important
  &.ant-switch-checked .ant-switch-handle
    inset-inline-start calc(100% - 16px) !important
  .ant-switch-inner
    display none !important

.app-theme-defaultDark
  .ant-input
  .ant-input-affix-wrapper
  .ant-select-selector
  .ant-picker
    color #DDEBF0 !important
    background rgba(255, 255, 255, .07) !important
    border-color rgba(169, 204, 224, .16) !important
    box-shadow none !important
  .ant-input::placeholder
  .ant-input-affix-wrapper input::placeholder
    color rgba(214, 227, 234, .48) !important
  .ant-modal-content
  .ant-drawer-content
  .ant-popover-inner
  .ant-dropdown-menu
    color #DDEBF0
    background linear-gradient(180deg, rgba(43, 63, 76, .9), rgba(25, 41, 51, .82)) !important
    border-color rgba(169, 204, 224, .16)
    box-shadow 0 10px 22px rgba(0, 0, 0, .18), inset 0 1px 0 rgba(255, 255, 255, .07) !important
  .ant-btn:not(.ant-btn-primary)
    color #D6E3EA
    background rgba(255, 255, 255, .07)
    border-color rgba(169, 204, 224, .16)
    &:hover
      color #FFFFFF !important
      background rgba(255, 255, 255, .11) !important
      border-color rgba(124, 212, 255, .24) !important
  .ant-switch
    background rgba(169, 204, 224, .28) !important
    &.ant-switch-checked
      background #31C176 !important
  .ant-form-item-label > label
    color #DDEBF0
  .ant-typography
    color #DDEBF0
  .ant-typography kbd
    color #DDEBF0
    background rgba(255, 255, 255, .08)
    border-color rgba(169, 204, 224, .16)
    box-shadow inset 0 -1px 0 rgba(255, 255, 255, .06)
  .ant-alert
    color #DDEBF0
    background rgba(18, 35, 46, .72) !important
    border-color rgba(124, 212, 255, .18) !important
  .ant-alert-message
  .ant-alert-description
    color #DDEBF0
  .ant-table-wrapper
    color #DDEBF0
    .ant-table
      color #DDEBF0
      background transparent
    .ant-table-thead > tr > th
      color #95AAB4
      background rgba(255, 255, 255, .07) !important
      border-bottom-color rgba(169, 204, 224, .14) !important
    .ant-table-tbody > tr > td
      color #DDEBF0
      background rgba(255, 255, 255, .055) !important
      border-bottom-color rgba(169, 204, 224, .12) !important
    .ant-table-tbody > tr:nth-child(even) > td
      background rgba(255, 255, 255, .075) !important
    .ant-table-tbody > tr:hover > td
      background rgba(255, 255, 255, .11) !important
    .ant-table-cell-row-hover
      background rgba(255, 255, 255, .11) !important
  .ant-pagination
    color #D6E3EA
    .ant-pagination-item
    .ant-pagination-prev
    .ant-pagination-next
      background rgba(255, 255, 255, .07)
      border-color rgba(169, 204, 224, .16)
      a
        color #D6E3EA
    .ant-pagination-item-active
      background linear-gradient(180deg, rgba(82, 142, 181, .34), rgba(47, 91, 118, .26))
      border-color rgba(124, 212, 255, .24)
      a
        color #DDF3FF
    .ant-pagination-disabled
      opacity .45
  .ant-tag
    border-radius 8px
    background rgba(255, 255, 255, .08)
    border-color rgba(169, 204, 224, .16)
    color #DDEBF0

.app-theme-defaultGlass
  .ant-input
  .ant-input-affix-wrapper
  .ant-select-selector
  .ant-picker
    background rgba(255, 255, 255, .64) !important
    border-color rgba(255, 255, 255, .72) !important
  .ant-modal-content
  .ant-drawer-content
  .ant-popover-inner
  .ant-dropdown-menu
    background linear-gradient(180deg, rgba(255, 255, 255, .72), rgba(238, 246, 249, .58)) !important
    border-color rgba(255, 255, 255, .72)
  .ant-alert
    background rgba(255, 255, 255, .58) !important
    border-color rgba(255, 255, 255, .74) !important
  .ant-table-wrapper
    .ant-table-thead > tr > th
      background rgba(255, 255, 255, .54) !important
      border-bottom-color rgba(255, 255, 255, .74) !important
    .ant-table-tbody > tr > td
      background rgba(255, 255, 255, .52) !important
      border-bottom-color rgba(255, 255, 255, .58) !important
    .ant-table-tbody > tr:nth-child(even) > td
      background rgba(255, 255, 255, .42) !important
    .ant-table-tbody > tr:hover > td
      background rgba(236, 246, 253, .72) !important
